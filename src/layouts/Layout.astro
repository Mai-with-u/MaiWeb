---
import '../styles/global.css';
import SeoHead from '../components/layout/SeoHead.astro';
import PageBackground from '../components/layout/PageBackground.astro';
import GlobalModal from '../components/layout/GlobalModal.astro';
import RevealScript from '../components/layout/RevealScript.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = 'MaiBot 官方网站',
  description = 'MaiBot - 一个正在努力成为人类的BOT',
  canonicalPath = '/',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <SeoHead title={title} description={description} canonicalPath={canonicalPath} />
  </head>
  <body>
    <PageBackground />
    <GlobalModal />

    <div class="page-wrapper">
      <slot />
    </div>

    <RevealScript />
  </body>
</html>

<style>
  .page-wrapper {
    position: relative;
    z-index: 1;
  }
</style>
