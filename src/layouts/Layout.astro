---
import '../styles/global.css';
import SeoHead from '../components/layout/SeoHead.astro';
import PageBackground from '../components/layout/PageBackground.astro';
import RevealScript from '../components/layout/RevealScript.astro';
import { useI18n } from '../lib/i18n';
const { locale, t, localPath } = useI18n(Astro.url);

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
}

const {
  title = 'MaiBot 官方网站',
  description = 'MaiBot - 一个正在努力成为人类的BOT',
  canonicalPath = '/',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <SeoHead title={t(title)} description={t(description)} canonicalPath={localPath(canonicalPath)} noindex={noindex} />
  </head>
  <body>
    <PageBackground />

    <div class="page-wrapper">
      <slot />
    </div>

    <RevealScript />
  </body>
</html>

<style>
  .page-wrapper {
    position: relative;
    z-index: 1;
  }
</style>
