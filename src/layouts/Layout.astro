---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = '麦麦Bot MaiBot MaiSaka' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="麦麦Bot - 一个正在努力成为人类的BOT" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@chinese-fonts/dymh/dist/DouyinSansBold/result.css" />
  </head>
  <body>
    <!-- Fixed Background Dots -->
    <div class="bg-dots" aria-hidden="true"></div>

    <div class="page-wrapper">
      <slot />
    </div>
  </body>
</html>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            // Remove transform after transition so backdrop-filter on children works
            entry.target.addEventListener('transitionend', () => {
              entry.target.style.transform = 'none';
            }, { once: true });
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
    );
    reveals.forEach((el) => observer.observe(el));
  });
</script>

<style>
  .bg-dots {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-color: rgba(var(--color-bg), 1);
    background-image: url('/tile-light.svg');
    background-repeat: repeat;
    background-size: 48px 48px;
    background-position: -24px -24px;
  }

  .page-wrapper {
    position: relative;
    z-index: 1;
  }
</style>
