---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import heroImage from '../assets/maimai-v2.png';

interface Props {
  title?: string;
}

const { title = 'MaiBot 官方网站' } = Astro.props;
const description = 'MaiBot - 一个正在努力成为人类的BOT';
const siteUrl = 'https://mai-mai.org';
const optimizedHero = await getImage({ src: heroImage, format: 'webp' });
const ogImage = new URL(optimizedHero.src, siteUrl).toString();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl} />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MaiBot" />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="preload"
      href="https://cdn.jsdelivr.net/npm/@chinese-fonts/dymh/dist/DouyinSansBold/result.css"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript
      ><link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/@chinese-fonts/dymh/dist/DouyinSansBold/result.css"
      /></noscript
    >
    <script is:inline>
      (function () {
        var apply = function (t) {
          document.documentElement.setAttribute('data-theme', t || 'light');
        };
        var saved = localStorage.getItem('theme');
        if (saved) {
          apply(saved);
        } else {
          apply(window.matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light');
        }
        window.matchMedia('(prefers-color-scheme:dark)').addEventListener('change', function (e) {
          if (!localStorage.getItem('theme')) {
            apply(e.matches ? 'dark' : 'light');
          }
        });
      })();
    </script>
  </head>
  <body>
    <!-- Fixed Background Dots -->
    <div class="bg-dots" aria-hidden="true"></div>

    <!-- Decorative crosses around the page -->
    <div class="deco-crosses" aria-hidden="true">
      <svg class="cross cross-1" viewBox="0 0 16 16"
        ><line x1="0" y1="8" x2="16" y2="8"></line><line x1="8" y1="0" x2="8" y2="16"></line></svg
      >
      <svg class="cross cross-2" viewBox="0 0 16 16"
        ><line x1="0" y1="8" x2="16" y2="8"></line><line x1="8" y1="0" x2="8" y2="16"></line></svg
      >
      <svg class="cross cross-3" viewBox="0 0 16 16"
        ><line x1="0" y1="8" x2="16" y2="8"></line><line x1="8" y1="0" x2="8" y2="16"></line></svg
      >
      <svg class="cross cross-4" viewBox="0 0 16 16"
        ><line x1="0" y1="8" x2="16" y2="8"></line><line x1="8" y1="0" x2="8" y2="16"></line></svg
      >
      <svg class="cross cross-5" viewBox="0 0 16 16"
        ><line x1="0" y1="8" x2="16" y2="8"></line><line x1="8" y1="0" x2="8" y2="16"></line></svg
      >
      <svg class="cross cross-6" viewBox="0 0 16 16"
        ><line x1="0" y1="8" x2="16" y2="8"></line><line x1="8" y1="0" x2="8" y2="16"></line></svg
      >
      <svg class="cross cross-7" viewBox="0 0 16 16"
        ><line x1="0" y1="8" x2="16" y2="8"></line><line x1="8" y1="0" x2="8" y2="16"></line></svg
      >
      <svg class="cross cross-8" viewBox="0 0 16 16"
        ><line x1="0" y1="8" x2="16" y2="8"></line><line x1="8" y1="0" x2="8" y2="16"></line></svg
      >
    </div>

    <!-- Decorative abstract blocks -->
    <div class="deco-blocks" aria-hidden="true">
      <div class="block block-1"></div>
      <div class="block block-2"></div>
      <div class="block block-outline block-3"></div>
      <div class="block block-outline block-4"></div>
      <!-- Triangle -->
      <svg class="block block-tri" viewBox="0 0 100 87"><polygon points="50,0 100,87 0,87"></polygon></svg>
      <!-- Diamonds -->
      <svg class="diamond diamond-1" viewBox="0 0 12 12"><polygon points="6,0 12,6 6,12 0,6"></polygon></svg>
      <svg class="diamond diamond-2" viewBox="0 0 12 12"><polygon points="6,0 12,6 6,12 0,6"></polygon></svg>
      <svg class="diamond diamond-3" viewBox="0 0 12 12"><polygon points="6,0 12,6 6,12 0,6"></polygon></svg>
      <!-- Corner brackets -->
      <svg class="bracket bracket-tl" viewBox="0 0 24 24"><path d="M22 2H6v4h12v12h4" fill="none"></path></svg>
      <svg class="bracket bracket-br" viewBox="0 0 24 24"><path d="M2 22h16v-4H6V6H2" fill="none"></path></svg>
      <svg class="bracket bracket-tr" viewBox="0 0 24 24"><path d="M2 2h16v4H6v12H2" fill="none"></path></svg>
      <!-- Thin angled lines -->
      <svg class="thinline thin-1" viewBox="0 0 60 1"><line x1="0" y1="0.5" x2="60" y2="0.5"></line></svg>
      <svg class="thinline thin-2" viewBox="0 0 1 80"><line x1="0.5" y1="0" x2="0.5" y2="80"></line></svg>
      <!-- Dot pairs -->
      <svg class="dotpair dots-1" viewBox="0 0 28 8"
        ><circle cx="4" cy="4" r="2"></circle><circle cx="24" cy="4" r="2"></circle></svg
      >
      <svg class="dotpair dots-2" viewBox="0 0 8 28"
        ><circle cx="4" cy="4" r="2"></circle><circle cx="4" cy="24" r="2"></circle></svg
      >
      <!-- Crosshair -->
      <svg class="crosshair" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="8" fill="none"></circle>
        <line x1="12" y1="2" x2="12" y2="7"></line><line x1="12" y1="17" x2="12" y2="22"></line>
        <line x1="2" y1="12" x2="7" y2="12"></line><line x1="17" y1="12" x2="22" y2="12"></line>
      </svg>
      <!-- Hexagon -->
      <svg class="hex" viewBox="0 0 52 60">
        <polygon points="26,0 52,15 52,45 26,60 0,45 0,15" fill="none"></polygon>
      </svg>
      <!-- Segmented bar -->
      <svg class="segbar" viewBox="0 0 48 4">
        <rect x="0" y="0" width="48" height="4" rx="2" fill="none"></rect>
        <rect x="0" y="0" width="18" height="4" rx="2"></rect>
      </svg>
    </div>

    <!-- Global Modal -->
    <div class="modal-overlay" id="global-modal" role="dialog" aria-modal="true" aria-label="弹窗" aria-hidden="true">
      <div class="modal-card" role="document">
        <button class="modal-close" aria-label="关闭">&times;</button>
        <div class="modal-body" id="modal-body"></div>
      </div>
    </div>

    <div class="page-wrapper">
      <slot />
    </div>
  </body>
</html>

<script>
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          // Remove transform after transition so backdrop-filter on children works
          entry.target.addEventListener(
            'transitionend',
            () => {
              (entry.target as HTMLElement).style.transform = 'none';
            },
            { once: true }
          );
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
  );
  reveals.forEach((el) => observer.observe(el));

  // Global modal
  const modal = document.getElementById('global-modal') as HTMLElement | null;
  const modalBody = document.getElementById('modal-body') as HTMLElement | null;
  const modalClose = modal?.querySelector('.modal-close') as HTMLElement | null;
  let lastTrigger: HTMLElement | null = null;

  function getFocusableElements(container: HTMLElement): HTMLElement[] {
    return Array.from(
      container.querySelectorAll<HTMLElement>(
        "a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex='-1'])"
      )
    ).filter((el) => el.offsetParent !== null);
  }

  function trapFocus(e: KeyboardEvent) {
    if (!modal || e.key !== 'Tab') return;
    const focusable = getFocusableElements(modal);
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  }

  function openModal(trigger: HTMLElement) {
    if (!modal || !modalBody) return;
    lastTrigger = trigger;
    const content = trigger.getAttribute('data-modal');
    if (content === 'qq') {
      modalBody.innerHTML = `<h2>💬 讨论与社区</h2><p style="font-size:12px;color:var(--c-text-muted)">Discussion and Community</p><p style="margin:8px 0">我们欢迎所有对 MaiBot 感兴趣的朋友加入！</p><p style="font-size:12px;color:var(--c-text-muted);margin-bottom:16px">We welcome everyone interested in MaiBot to join us.</p><table><tr><th>技术交流<br><small style="font-weight:400">Technical</small></th><td><b>麦麦脑电图</b>: 571780722<br><small style="color:var(--c-text-muted)">MaiBrain EEG</small></td><td>技术交流 / 答疑<br><small style="color:var(--c-text-muted)">Technical discussion / Q&A</small></td></tr><tr><th>技术交流<br><small style="font-weight:400">Technical</small></th><td><b>麦麦大脑磁共振</b>: 766798517<br><small style="color:var(--c-text-muted)">MaiBrain MRI</small></td><td>技术交流 / 答疑<br><small style="color:var(--c-text-muted)">Technical discussion / Q&A</small></td></tr><tr><th>技术交流<br><small style="font-weight:400">Technical</small></th><td><a href="https://qm.qq.com/q/wGePTl1UyY" target="_blank" rel="noopener noreferrer">麦麦要当 VTB</a><br><small style="color:var(--c-text-muted)">Mai Wants to Be a VTuber</small></td><td>技术交流 / 答疑<br><small style="color:var(--c-text-muted)">Technical discussion / Q&A</small></td></tr><tr><th>闲聊吹水<br><small style="font-weight:400">Casual Chat</small></th><td><a href="https://qm.qq.com/q/JxvHZnxyec" target="_blank" rel="noopener noreferrer">麦麦之闲聊群</a><br><small style="color:var(--c-text-muted)">Mai Casual Chat Group</small></td><td>仅限闲聊，不答疑<br><small style="color:var(--c-text-muted)">Casual chat only, no support</small></td></tr><tr><th>插件开发<br><small style="font-weight:400">Plugin Dev</small></th><td><b>插件开发群</b>: 1036092828<br><small style="color:var(--c-text-muted)">Plugin Dev Group</small></td><td>进阶开发与测试<br><small style="color:var(--c-text-muted)">Advanced development and testing</small></td></tr></table>`;
    } else if (content === 'versions') {
      modalBody.innerHTML =
        '<h2>📦 选择安装方式</h2>' +
        '<div style="display:flex;flex-direction:column;gap:16px;margin-top:16px">' +
        '<a href="https://github.com/Mai-with-u/MaiBot/releases/latest" target="_blank" rel="noopener noreferrer" style="display:block;padding:20px;border:1.5px solid rgba(var(--color-primary),0.3);border-radius:16px;text-decoration:none;color:inherit;transition:all 0.2s">' +
        '<div style="font-size:18px;font-weight:700;color:var(--c-primary);margin-bottom:4px">📋 源码安装</div>' +
        '<div style="font-size:13px;color:var(--c-text-muted)">适合人群：适合喜欢用源码部署的人</div>' +
        '</a>' +
        '<div style="padding:20px;border:1.5px solid rgba(var(--color-primary),0.3);border-radius:16px">' +
        '<div style="font-size:18px;font-weight:700;color:var(--c-primary);margin-bottom:4px">🐳 Docker 安装</div>' +
        '<div style="font-size:13px;color:var(--c-text-muted);margin-bottom:12px">适合人群：适合喜欢用 Docker 的人</div>' +
        '<div style="background:rgba(var(--color-text-muted),0.06);border-radius:12px;padding:14px 16px;font-size:13px;line-height:1.7">' +
        '<p style="font-weight:700;margin-bottom:8px">🚀 5 分钟快速部署</p>' +
        '<p style="font-weight:600;margin:8px 0 4px">1. 下载 MaiBot</p>' +
        '<pre style="background:rgba(0,0,0,0.05);padding:8px 12px;border-radius:8px;overflow-x:auto;font-size:12px;margin:4px 0">git clone https://github.com/Mai-with-u/MaiBot.git\ncd MaiBot</pre>' +
        '<p style="font-weight:600;margin:12px 0 4px">2. 一键启动！</p>' +
        '<pre style="background:rgba(0,0,0,0.05);padding:8px 12px;border-radius:8px;overflow-x:auto;font-size:12px;margin:4px 0">docker compose up -d</pre>' +
        '<p style="font-size:12px;color:var(--c-text-muted);margin-top:4px">第一次启动会自动生成配置文件，然后会停下来等你配置。</p>' +
        '<p style="margin-top:12px;font-weight:600">已经下载？</p>' +
        '<p style="font-size:13px">运行后浏览器打开 <code style="background:rgba(var(--color-primary),0.1);padding:2px 6px;border-radius:4px;font-size:12px">http://127.0.0.1:8001</code> 即可进入 WebUI 配置界面！</p>' +
        '</div>' +
        '</div>' +
        '</div>';
    } else {
      modalBody.innerHTML = '<p style="text-align:center;font-size:20px;padding:20px">呃啊还没做……</p>';
    }
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.addEventListener('keydown', handleKeyDown);
    requestAnimationFrame(() => modalClose?.focus());
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.removeEventListener('keydown', handleKeyDown);
    if (modalBody) modalBody.innerHTML = '';
    lastTrigger?.focus();
    lastTrigger = null;
  }

  function handleKeyDown(e: KeyboardEvent) {
    if (e.key === 'Escape') {
      closeModal();
      return;
    }
    trapFocus(e);
  }

  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-modal]');
    if (trigger) {
      e.preventDefault();
      openModal(trigger);
      return;
    }
    if ((e.target as HTMLElement).closest('.modal-close') || (e.target as HTMLElement).matches('.modal-overlay')) {
      closeModal();
    }
  });
</script>

<style>
  .bg-dots {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-color: rgb(var(--color-bg));
    background-image: url('/tile-light.svg');
    background-repeat: repeat;
    background-size: 48px 48px;
    background-position: 0 0;
  }

  :global([data-theme='dark']) .bg-dots {
    background-color: #121212;
    background-image: url('/tile-dark.svg');
    background-repeat: repeat;
    background-size: 48px 48px;
    background-position: 0 0;
  }

  .page-wrapper {
    position: relative;
    z-index: 1;
  }

  /* Decorative crosses */
  .deco-crosses {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .cross {
    position: absolute;
    width: 20px;
    height: 20px;
    stroke: rgb(var(--color-text-muted));
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.4;
  }

  :global([data-theme='dark']) .cross {
    stroke: #555;
    opacity: 0.6;
  }

  .cross-1 {
    top: 6%;
    left: 8%;
  }
  .cross-2 {
    top: 6%;
    left: 50%;
    transform: translateX(-50%);
  }
  .cross-3 {
    top: 6%;
    right: 8%;
  }
  .cross-4 {
    top: 50%;
    left: 3%;
    transform: translateY(-50%);
  }
  .cross-5 {
    top: 50%;
    right: 3%;
    transform: translateY(-50%);
  }
  .cross-6 {
    bottom: 6%;
    left: 8%;
  }
  .cross-7 {
    bottom: 6%;
    left: 50%;
    transform: translateX(-50%);
  }
  .cross-8 {
    bottom: 6%;
    right: 8%;
  }

  /* Decorative abstract blocks */
  .deco-blocks {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .block {
    position: absolute;
    border-radius: 24px;
    background: rgb(var(--color-text-muted));
    opacity: 0.07;
  }

  :global([data-theme='dark']) .block {
    background: #4a4a4a;
    opacity: 0.14;
  }

  .block-outline {
    background: transparent;
    border: 1.5px solid rgb(var(--color-text-muted));
    opacity: 0.1;
  }

  :global([data-theme='dark']) .block-outline {
    background: transparent;
    border-color: #555;
    opacity: 0.2;
  }

  .block-1 {
    top: 14%;
    left: -3%;
    width: 200px;
    height: 80px;
    border-radius: 6px 36px 6px 6px;
    transform: rotate(-8deg);
  }
  .block-2 {
    top: 55%;
    right: -5%;
    width: 150px;
    height: 150px;
    border-radius: 44px 8px 44px 8px;
    transform: rotate(14deg);
  }
  .block-3 {
    top: 72%;
    left: 6%;
    width: 80px;
    height: 80px;
    border-radius: 14px 3px 14px 3px;
    transform: rotate(-18deg);
  }
  .block-4 {
    top: 20%;
    right: 14%;
    width: 56px;
    height: 56px;
    border-radius: 3px 14px 3px 14px;
    transform: rotate(30deg);
  }

  .block-tri {
    position: absolute;
    top: 42%;
    left: 5%;
    width: 36px;
    height: 31px;
    opacity: 0.05;
    fill: rgb(var(--color-text-muted));
    transform: rotate(-12deg);
  }

  :global([data-theme='dark']) .block-tri {
    fill: #555;
    opacity: 0.12;
  }

  /* Diamonds */
  .diamond {
    position: absolute;
    width: 16px;
    height: 16px;
    fill: rgb(var(--color-text-muted));
    opacity: 0.2;
  }

  :global([data-theme='dark']) .diamond {
    fill: #555;
    opacity: 0.35;
  }

  .diamond-1 {
    top: 22%;
    right: 22%;
  }
  .diamond-2 {
    bottom: 22%;
    left: 14%;
  }
  .diamond-3 {
    top: 55%;
    left: 28%;
  }

  /* Corner brackets */
  .bracket {
    position: absolute;
    width: 40px;
    height: 40px;
    stroke: rgb(var(--color-text-muted));
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
    opacity: 0.18;
  }

  :global([data-theme='dark']) .bracket {
    stroke: #555;
    opacity: 0.3;
  }

  .bracket-tl {
    top: 8%;
    left: 20%;
  }
  .bracket-br {
    bottom: 14%;
    right: 16%;
  }
  .bracket-tr {
    top: 60%;
    right: 24%;
  }

  /* Thin lines */
  .thinline {
    position: absolute;
    stroke: rgb(var(--color-text-muted));
    stroke-width: 1;
    opacity: 0.12;
  }

  :global([data-theme='dark']) .thinline {
    stroke: #555;
    opacity: 0.22;
  }

  .thin-1 {
    top: 48%;
    right: 8%;
    width: 80px;
    height: 1px;
  }
  .thin-2 {
    bottom: 20%;
    left: 10%;
    width: 1px;
    height: 100px;
  }

  /* Dot pairs */
  .dotpair {
    position: absolute;
    fill: rgb(var(--color-text-muted));
    opacity: 0.18;
  }

  :global([data-theme='dark']) .dotpair {
    fill: #555;
    opacity: 0.3;
  }

  .dots-1 {
    top: 32%;
    right: 30%;
    width: 36px;
    height: 10px;
  }
  .dots-2 {
    bottom: 28%;
    left: 22%;
    width: 10px;
    height: 36px;
  }

  /* Crosshair */
  .crosshair {
    position: absolute;
    top: 38%;
    right: 10%;
    width: 50px;
    height: 50px;
    stroke: rgb(var(--color-text-muted));
    stroke-width: 1.2;
    fill: none;
    opacity: 0.14;
  }

  :global([data-theme='dark']) .crosshair {
    stroke: #555;
    opacity: 0.25;
  }

  /* Hexagon */
  .hex {
    position: absolute;
    top: 25%;
    left: 38%;
    width: 72px;
    height: 83px;
    stroke: rgb(var(--color-text-muted));
    stroke-width: 1.2;
    fill: none;
    opacity: 0.1;
    transform: rotate(15deg);
  }

  :global([data-theme='dark']) .hex {
    stroke: #555;
    opacity: 0.2;
  }

  /* Segmented bar */
  .segbar {
    position: absolute;
    bottom: 18%;
    right: 20%;
    width: 80px;
    height: 6px;
    fill: rgb(var(--color-text-muted));
    stroke: rgb(var(--color-text-muted));
    stroke-width: 1;
    opacity: 0.15;
  }

  :global([data-theme='dark']) .segbar {
    fill: #555;
    stroke: #555;
    opacity: 0.25;
  }

  /* === Global Modal === */
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .modal-overlay.is-open {
    opacity: 1;
