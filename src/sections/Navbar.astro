---
import { useI18n } from '../lib/i18n';
import { Image } from 'astro:assets';
import logoIcon from '../assets/logo-icon.png';
import LanguageDialog from '../components/dialog/LanguageDialog.astro';
import LeaveSiteDialog from '../components/dialog/LeaveSiteDialog.astro';
import { links } from '../data/links';
const { t, localPath } = useI18n(Astro.url);

// 当前页对应的导航项加 aria-current，屏幕阅读器能读出“当前页面”，样式上也高亮
const pathname = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => (pathname === localPath(href) ? 'page' : undefined);
---

<div class="navbar-blur">
  <nav class="navbar-wrap" aria-label={t('主导航')}>
    <div class="navbar-glass">
      <div class="navbar-accent"></div>
      <a href={localPath('/')} class="navbar-logo" aria-label={t('麦麦Bot 首页')}>
        <div class="logo-icon">
          <Image src={logoIcon} alt="" width={40} height={40} loading="eager" decoding="async" />
        </div>
        <div class="logo-text">
          <span class="logo-title">{t('麦麦Bot')}</span>
          <span class="logo-subtitle">MaiBot</span>
        </div>
      </a>

      <div class="nav-divider"></div>

      <div class="nav-menu">
        <a href={localPath('/projects/')} class="nav-item" aria-current={isCurrent('/projects/')}>
          {t('衍生项目')}
        </a>
        <div class="nav-separator"></div>
        <a
          href={links.pluginMarket}
          class="nav-item"
          data-leave-confirm
          data-leave-name={t('麦麦插件市场')}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t('插件市场')}
        </a>
        <div class="nav-separator"></div>
        <div class="nav-dropdown">
          <button
            class="nav-item nav-dropdown-trigger"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="nav-docs-menu"
          >
            {t('使用文档')}
            <svg class="nav-arrow" viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true">
              <path d="M12 15l-4.243-4.243 1.415-1.414L12 12.172l2.828-2.829 1.415 1.414z"></path>
            </svg>
          </button>
          <div class="nav-dropdown-menu" id="nav-docs-menu">
            <a
              href={links.manual}
              class="nav-dropdown-link"
              data-leave-confirm
              data-leave-name={t('MaiBot 文档站')}
              target="_blank"
              rel="noopener noreferrer"
            >
              {t('用户手册')}
            </a>
            <a
              href={links.develop}
              class="nav-dropdown-link"
              data-leave-confirm
              data-leave-name={t('MaiBot 文档站')}
              target="_blank"
              rel="noopener noreferrer"
            >
              {t('开发文档')}
            </a>
            <a
              href={links.faq}
              class="nav-dropdown-link"
              data-leave-confirm
              data-leave-name={t('MaiBot 文档站')}
              target="_blank"
              rel="noopener noreferrer"
            >
              {t('常见问题')}
            </a>
          </div>
        </div>
        <div class="nav-separator"></div>
        <a href={localPath('/about/')} class="nav-item" aria-current={isCurrent('/about/')}>
          {t('关于麦麦')}
        </a>
      </div>

      <div class="nav-actions">
        <button class="theme-toggle" type="button" aria-label={t('切换深色模式')}>
          <svg
            class="icon-sun"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
          </svg>
        </button>
        <button
          class="lang-switch"
          type="button"
          aria-label={t('切换语言')}
          data-dialog="lang"
          aria-haspopup="dialog"
          aria-controls="dialog-lang"
        >
          <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M3.33333 10V11.3333C3.33333 12.0363 3.87725 12.6121 4.56716 12.663L4.66667 12.6667H6.66667V14H4.66667C3.19391 14 2 12.8061 2 11.3333V10H3.33333ZM12 6.66667L14.9333 14H13.4967L12.696 12H9.96933L9.17 14H7.734L10.6667 6.66667H12ZM11.3333 8.59013L10.502 10.6667H12.1633L11.3333 8.59013ZM5.33333 1.33333V2.66667H8V7.33333H5.33333V9.33333H4V7.33333H1.33333V2.66667H4V1.33333H5.33333ZM11.3333 2C12.8061 2 14 3.19391 14 4.66667V6H12.6667V4.66667C12.6667 3.93029 12.0697 3.33333 11.3333 3.33333H9.33333V2H11.3333ZM4 4H2.66667V6H4V4ZM6.66667 4H5.33333V6H6.66667V4Z"></path>
          </svg>
        </button>
        <button
          class="nav-hamburger"
          type="button"
          aria-label={t('展开菜单')}
          aria-expanded="false"
          aria-controls="nav-mobile-menu"
        >
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <span class="nav-cta-wrap">
          <a
            href={links.manual}
            class="nav-cta"
            data-leave-confirm
            data-leave-name={t('MaiBot 文档站')}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t('部署')}
          </a>
        </span>
      </div>
    </div>

    <div class="nav-menu-mobile" id="nav-mobile-menu">
      <a href={localPath('/projects/')} class="nav-item-mobile" aria-current={isCurrent('/projects/')}>
        {t('衍生项目')}
      </a>
      <a
        href={links.pluginMarket}
        class="nav-item-mobile"
        data-leave-confirm
        data-leave-name={t('麦麦插件市场')}
        target="_blank"
        rel="noopener noreferrer"
      >
        {t('插件市场')}
      </a>
      <a
        href={links.manual}
        class="nav-item-mobile"
        data-leave-confirm
        data-leave-name={t('MaiBot 文档站')}
        target="_blank"
        rel="noopener noreferrer"
      >
        {t('用户手册')}
      </a>
      <a
        href={links.develop}
        class="nav-item-mobile"
        data-leave-confirm
        data-leave-name={t('MaiBot 文档站')}
        target="_blank"
        rel="noopener noreferrer"
      >
        {t('开发文档')}
      </a>
      <a
        href={links.faq}
        class="nav-item-mobile"
        data-leave-confirm
        data-leave-name={t('MaiBot 文档站')}
        target="_blank"
        rel="noopener noreferrer"
      >
        {t('常见问题')}
      </a>
      <a href={localPath('/about/')} class="nav-item-mobile" aria-current={isCurrent('/about/')}>
        {t('关于麦麦')}
      </a>
    </div>
  </nav>
</div>

<LanguageDialog />
<LeaveSiteDialog />

<style>
  /* 定位层：左右 0 + margin auto + fit-content 实现水平居中，不再用 transform 缩放（缩放会让文字发糊）。
     导航栏自身的毛玻璃和投影都画在 .navbar-glass 的伪元素上，外层容器不能再带 filter / backdrop-filter：
     这两个属性会把外层变成“背景根”，下拉菜单和手机菜单的 backdrop-filter 就只能模糊导航栏自己，
     透不到页面，毛玻璃会失效。
     本文件的 backdrop-filter 只写标准属性，Safari 需要的 -webkit- 前缀由构建时 Lightning CSS 按 cssTarget 补上；
     手写前缀会被它与标准写法合并成一条，反而让某一类浏览器失去毛玻璃 */
  .navbar-blur {
    position: fixed;
    top: max(var(--safe-top), 1rem);
    right: 0;
    left: 0;
    z-index: 100;
    width: fit-content;
    margin-inline: auto;
  }

  .navbar-wrap {
    animation: fadeInDown 0.48s ease-out;
  }

  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-0.75rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* === Inner: cut corner + background === */
  .navbar-glass {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: min(47rem, calc(100vw - 2rem - var(--safe-left) - var(--safe-right)));
    height: 4rem;
    padding: 0 1rem;
    background: transparent;
    isolation: isolate;
  }

  /* 玻璃底：半透明白底 + 背景模糊，clip-path 切出右下角，模糊效果也随之切成同样的形状 */
  .navbar-glass::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: '';
    background: rgba(255, 255, 255, 0.7);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 0.875rem), calc(100% - 0.875rem) 100%, 0 100%);
    backdrop-filter: saturate(180%) blur(1.25rem);
  }

  /* 投影：单独一层模糊的暗色块垫在玻璃下面，效果等同原来外层的 drop-shadow，但不再包住下拉菜单 */
  .navbar-glass::after {
    position: absolute;
    inset: 0;
    z-index: -2;
    content: '';
    background: rgba(0, 0, 0, 0.09);
    filter: blur(0.625rem);
    transform: translateY(0.25rem);
    pointer-events: none;
  }

  .navbar-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0.25rem;
    background: rgba(233, 127, 15, 0.85);
  }

  .navbar-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-left: 0.25rem;
    text-decoration: none;
    color: inherit;
  }

  .logo-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 1rem;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: 0 0.25rem 0.25rem rgba(0, 0, 0, 0.25);
  }

  .logo-icon img {
    width: 2.5rem;
    height: 2.5rem;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .logo-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: #000;
    letter-spacing: 0.48px;
  }

  .logo-subtitle {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    color: #808080;
    letter-spacing: 0.36px;
  }

  .nav-divider {
    width: 1px;
    height: 1.5rem;
    background: rgba(0, 0, 0, 0.12);
    transform: rotate(15deg);
    flex-shrink: 0;
  }

  .nav-menu {
    display: none;
    align-items: center;
    gap: 0;
    flex: 1;
  }

  .nav-separator {
    width: 1px;
    height: 1rem;
    background: rgba(0, 0, 0, 0.08);
    flex-shrink: 0;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 0.5rem 0.625rem;
    border: none;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #a2abbc;
    border-radius: 0.5rem;
    transition: all var(--transition-fast);
    white-space: nowrap;
    text-decoration: none;
    background: transparent;
    cursor: pointer;
  }

  .nav-item:hover,
  .nav-dropdown.is-open .nav-dropdown-trigger {
    color: var(--c-primary);
    background: rgba(233, 127, 15, 0.08);
  }

  .nav-arrow {
    opacity: 0.7;
    transition: transform var(--transition-fast);
  }

  .nav-dropdown {
    position: relative;
  }

  /* 下拉菜单：是否展开只由脚本给 .nav-dropdown 加减 is-open 决定（不再用 :hover / :focus-within 直接显示）。
     收起时用 visibility 延迟隐藏，让淡出和回缩动画播完；展开时从按钮下方轻微下落、放大、淡入，菜单项依次出现 */
  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 0.875rem);
    left: 50%;
    display: grid;
    min-width: 8.5rem;
    padding: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 0.875rem;
    background: rgba(255, 255, 255, 0.72);
    box-shadow: 0 0.75rem 2rem rgba(0, 0, 0, 0.14);
    backdrop-filter: blur(1.25rem) saturate(180%);
    visibility: hidden;
    opacity: 0;
    transform: translate(-50%, -0.5rem) scale(0.96);
    transform-origin: top center;
    transition:
      opacity 0.16s ease,
      transform 0.2s ease,
      visibility 0s linear 0.2s;
  }

  /* 按钮和菜单之间 14px 的空隙用透明块补上，鼠标移过去不会中途离开下拉区域 */
  .nav-dropdown-menu::before {
    position: absolute;
    top: -0.875rem;
    left: 0;
    width: 100%;
    height: 0.875rem;
    content: '';
  }

  .nav-dropdown.is-open .nav-dropdown-menu {
    visibility: visible;
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
    transition:
      opacity 0.18s ease,
      transform 0.28s cubic-bezier(0.2, 0.9, 0.3, 1.15),
      visibility 0s;
  }

  .nav-dropdown.is-open .nav-arrow {
    transform: rotate(180deg);
  }

  /* 当前所在页面的导航项保持高亮 */
  .nav-item[aria-current='page'],
  .nav-item-mobile[aria-current='page'] {
    color: var(--c-primary);
  }

  .nav-dropdown-link {
    display: flex;
    align-items: center;
    padding: 0.5625rem 0.75rem;
    border-radius: 0.625rem;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #1b1b1b;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-0.25rem);
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast),
      opacity 0.2s ease var(--stagger, 0s),
      transform 0.24s ease var(--stagger, 0s);
  }

  /* 展开时菜单项依次出现，每项晚 40ms */
  .nav-dropdown.is-open .nav-dropdown-link,
  .nav-menu-mobile.is-open .nav-item-mobile {
    opacity: 1;
    transform: none;
  }

  .nav-dropdown.is-open .nav-dropdown-link:nth-child(2),
  .nav-menu-mobile.is-open .nav-item-mobile:nth-child(2) {
    --stagger: 0.04s;
  }

  .nav-dropdown.is-open .nav-dropdown-link:nth-child(3),
  .nav-menu-mobile.is-open .nav-item-mobile:nth-child(3) {
    --stagger: 0.08s;
  }

  .nav-menu-mobile.is-open .nav-item-mobile:nth-child(4) {
    --stagger: 0.12s;
  }

  .nav-menu-mobile.is-open .nav-item-mobile:nth-child(5) {
    --stagger: 0.16s;
  }

  .nav-dropdown-link:hover,
  .nav-dropdown-link:focus-visible {
    color: var(--c-primary);
    background: rgba(233, 127, 15, 0.08);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  /* 主题切换与语言切换：两个图标按钮共用一套样式 */
  .theme-toggle,
  .lang-switch {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    color: #a2abbc;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .theme-toggle:hover,
  .lang-switch:hover {
    color: var(--c-primary);
    background: rgba(233, 127, 15, 0.08);
  }

  .theme-toggle .icon-moon {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle .icon-sun {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle .icon-moon {
    display: block;
  }

  /* === Dark mode navbar === */
  :global([data-theme='dark']) .navbar-glass::before {
    background: rgba(28, 28, 28, 0.85);
  }

  :global([data-theme='dark']) .logo-title,
  :global([data-theme='dark']) .nav-hamburger,
  :global([data-theme='dark']) .nav-item-mobile {
    color: var(--text-strong);
  }

  :global([data-theme='dark']) .logo-subtitle,
  :global([data-theme='dark']) .nav-item,
  :global([data-theme='dark']) .theme-toggle,
  :global([data-theme='dark']) .lang-switch {
    color: #fafafa;
  }

  :global([data-theme='dark']) .nav-dropdown-menu {
    border-color: rgba(255, 255, 255, 0.08);
    background: rgba(38, 38, 38, 0.72);
  }

  :global([data-theme='dark']) .nav-dropdown-link {
    color: #fafafa;
  }

  :global([data-theme='dark']) .nav-divider,
  :global([data-theme='dark']) .nav-separator {
    background: rgba(255, 255, 255, 0.1);
  }

  :global([data-theme='dark']) .nav-item:hover,
  :global([data-theme='dark']) .nav-dropdown.is-open .nav-dropdown-trigger,
  :global([data-theme='dark']) .nav-dropdown-link:hover,
  :global([data-theme='dark']) .nav-dropdown-link:focus-visible,
  :global([data-theme='dark']) .theme-toggle:hover,
  :global([data-theme='dark']) .lang-switch:hover,
  :global([data-theme='dark']) .nav-item-mobile:hover {
    background: rgba(245, 148, 25, 0.12);
    color: var(--c-primary);
  }

  :global([data-theme='dark']) .nav-menu-mobile {
    border-color: rgba(255, 255, 255, 0.08);
    background: rgba(38, 38, 38, 0.72);
  }

  /* deploy button */
  .nav-cta-wrap {
    display: inline-flex;
    flex-shrink: 0;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 0.5rem), calc(100% - 0.5rem) 100%, 0 100%);
    filter: drop-shadow(0 0.25rem 1rem rgba(0, 0, 0, 0.2));
    transition: filter var(--transition-fast);
  }

  .nav-cta-wrap:hover {
    filter: drop-shadow(0 0.375rem 1.5rem rgba(0, 0, 0, 0.3));
  }

  .nav-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1.25rem;
    height: 2.75rem;
    min-width: 5.25rem;
    background: #e97f0f;
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.48px;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .nav-cta-wrap:hover .nav-cta {
    background: #d06d0a;
    transform: translateY(-1px);
  }

  .nav-hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: none;
    background: transparent;
    color: #1b1b1b;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .nav-hamburger:hover {
    background: rgba(233, 127, 15, 0.08);
    color: var(--c-primary);
  }

  /* 汉堡图标：展开时上下两条线旋转成 ×，中间一条淡出 */
  .nav-hamburger line {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 0.28s cubic-bezier(0.2, 0.9, 0.3, 1.15),
      opacity 0.2s ease;
  }

  .nav-hamburger[aria-expanded='true'] line:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .nav-hamburger[aria-expanded='true'] line:nth-child(2) {
    opacity: 0;
  }

  .nav-hamburger[aria-expanded='true'] line:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* 手机菜单：常驻在导航栏下方，收起时隐藏并上移缩小；展开时下落、放大、淡入，菜单项依次出现 */
  .nav-menu-mobile {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;
    left: 0;
    z-index: 99;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.72);
    box-shadow: 0 0.25rem 1.25rem rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(1.25rem) saturate(180%);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-0.5rem) scale(0.97);
    transform-origin: top center;
    transition:
      opacity 0.16s ease,
      transform 0.2s ease,
      visibility 0s linear 0.2s;
  }

  .nav-menu-mobile.is-open {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
      opacity 0.18s ease,
      transform 0.28s cubic-bezier(0.2, 0.9, 0.3, 1.15),
      visibility 0s;
  }

  .nav-item-mobile {
    display: flex;
    align-items: center;
    padding: 0.625rem 0.75rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: #1b1b1b;
    border-radius: 0.5rem;
    text-decoration: none;
    opacity: 0;
    transform: translateY(-0.25rem);
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast),
      opacity 0.2s ease var(--stagger, 0s),
      transform 0.24s ease var(--stagger, 0s);
  }

  .nav-item-mobile:hover {
    background: rgba(233, 127, 15, 0.08);
    color: var(--c-primary);
  }

  /* 窄屏（< 48rem）：收起文字菜单，改用汉堡按钮展开下拉面板 */
  @media (max-width: 767.98px) {
    .navbar-glass {
      width: auto;
      min-width: min(18.75rem, calc(100vw - 2rem - var(--safe-left) - var(--safe-right)));
      max-width: calc(100vw - 2rem - var(--safe-left) - var(--safe-right));
      gap: 0.375rem;
      padding: 0 0.5rem;
    }

    .nav-divider {
      display: none;
    }

    /* 触屏下图标按钮放大到 40px，按钮间距收紧一些，保证 Logo 文字不被挤成两行 */
    .nav-actions {
      gap: 0.25rem;
    }

    .logo-title,
    .logo-subtitle {
      white-space: nowrap;
    }

    .logo-title {
      font-size: 0.875rem;
    }

    .logo-subtitle {
      font-size: 0.625rem;
    }

    .nav-cta {
      height: 2.25rem;
      min-width: 0;
      padding: 0.375rem 0.875rem;
      font-size: 0.875rem;
    }

    .nav-hamburger {
      display: flex;
    }
  }

  /* 极窄屏（< 360px）放不下 Logo 文字和四个按钮，只保留 Logo 图标 */
  @media (max-width: 359.98px) {
    .logo-text {
      display: none;
    }
  }

  /* 宽屏（>= 48rem）：展示完整文字菜单，手机菜单彻底不渲染 */
  @media (min-width: 768px) {
    .nav-menu {
      display: flex;
    }

    .nav-menu-mobile {
      display: none;
    }
  }

  /* 触屏设备把图标按钮放大，接近 44px 的推荐点击尺寸（触控尺寸保持 px，不随宽屏缩放变小） */
  @media (pointer: coarse) {
    .theme-toggle,
    .lang-switch,
    .nav-hamburger {
      width: 40px;
      height: 40px;
    }
  }
</style>

<script>
  import { translator } from '../lib/i18n';
  const t = translator(document.documentElement.lang === 'en' ? 'en' : 'zh-CN');
  const logo = document.querySelector('.navbar-logo');
  if (logo) {
    logo.addEventListener('click', (e) => {
      if (window.location.pathname === '/' || window.location.pathname === '') {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  }

  // 文档下拉菜单：展开状态只由这里维护（.nav-dropdown 的 is-open + 按钮的 aria-expanded），CSS 只负责按状态显示和动画。
  // 鼠标：移入按钮或菜单立即展开，移出 150ms 后收起（留出从按钮滑到菜单的时间）；
  // 触屏和键盘：点击按钮切换；点菜单外部、按 Esc、焦点移出下拉区域、点击菜单项都会收起；
  // 键盘额外支持在按钮上按 ↓ 展开并聚焦第一项，在菜单内用 ↑ ↓ 切换。
  const dropdown = document.querySelector<HTMLElement>('.nav-dropdown');
  const dropdownTrigger = dropdown?.querySelector<HTMLButtonElement>('.nav-dropdown-trigger');
  const dropdownMenu = dropdown?.querySelector<HTMLElement>('.nav-dropdown-menu');
  if (dropdown && dropdownTrigger && dropdownMenu) {
    const items = Array.from(dropdownMenu.querySelectorAll<HTMLAnchorElement>('a'));
    let closeTimer: ReturnType<typeof setTimeout> | undefined;
    let openedByHover = false;
    let lastPointerType = '';

    const isOpen = () => dropdown.classList.contains('is-open');
    const setOpen = (open: boolean) => {
      clearTimeout(closeTimer);
      dropdown.classList.toggle('is-open', open);
      dropdownTrigger.setAttribute('aria-expanded', String(open));
      if (!open) openedByHover = false;
    };

    dropdown.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      clearTimeout(closeTimer);
      if (!isOpen()) {
        setOpen(true);
        openedByHover = true;
      }
    });

    dropdown.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse') return;
      clearTimeout(closeTimer);
      closeTimer = setTimeout(() => setOpen(false), 150);
    });

    dropdownTrigger.addEventListener('pointerdown', (e) => {
      lastPointerType = e.pointerType;
    });

    dropdownTrigger.addEventListener('click', () => {
      // 鼠标悬停刚把菜单展开时再点按钮，视为“确认要看”，保持展开；之后再点才收起
      if (lastPointerType === 'mouse' && openedByHover) {
        openedByHover = false;
      } else {
        setOpen(!isOpen());
      }
      lastPointerType = '';
    });

    dropdown.addEventListener('keydown', (e) => {
      const index = items.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        dropdownTrigger.focus();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (!isOpen()) setOpen(true);
        items[(index + 1) % items.length]?.focus();
      } else if (e.key === 'ArrowUp' && index >= 0) {
        e.preventDefault();
        items[(index - 1 + items.length) % items.length]?.focus();
      }
    });

    dropdown.addEventListener('focusout', (e) => {
      if (!dropdown.contains(e.relatedTarget as Node | null)) setOpen(false);
    });

    items.forEach((link) => link.addEventListener('click', () => setOpen(false)));

    document.addEventListener('click', (e) => {
      if (isOpen() && !dropdown.contains(e.target as Node)) setOpen(false);
    });
  }

  // 汉堡菜单：点击按钮展开或收起；点菜单里的链接、按 Esc、点菜单外部、或窗口变宽到显示完整菜单时自动收起
  const hamburger = document.querySelector<HTMLButtonElement>('.nav-hamburger');
  const mobileMenu = document.querySelector<HTMLElement>('.nav-menu-mobile');
  if (hamburger && mobileMenu) {
    const setMobileMenu = (open: boolean) => {
      mobileMenu.classList.toggle('is-open', open);
      hamburger.setAttribute('aria-expanded', String(open));
      hamburger.setAttribute('aria-label', t(open ? '收起菜单' : '展开菜单'));
    };

    hamburger.addEventListener('click', () => setMobileMenu(!mobileMenu.classList.contains('is-open')));

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMobileMenu(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileMenu.classList.contains('is-open')) {
        setMobileMenu(false);
        hamburger.focus();
      }
    });

    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!mobileMenu.contains(target) && !hamburger.contains(target)) setMobileMenu(false);
    });

    window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
      if (e.matches) setMobileMenu(false);
    });
  }

  const themeToggle = document.querySelector('.theme-toggle');
  if (themeToggle) {
    // 点击切换主题：先临时挂上过渡类让颜色平滑变化，切换完成后再移除，平时不影响其他动效
    let switchTimer: ReturnType<typeof setTimeout> | undefined;
    themeToggle.addEventListener('click', () => {
      const html = document.documentElement;
      const isDark = html.getAttribute('data-theme') === 'dark';
      const next = isDark ? 'light' : 'dark';
      html.classList.add('theme-switching');
      html.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        // 隐私模式下可能无法写入，本次切换照样生效，只是刷新后不记忆
      }
      clearTimeout(switchTimer);
      switchTimer = setTimeout(() => html.classList.remove('theme-switching'), 400);
    });
  }
</script>
