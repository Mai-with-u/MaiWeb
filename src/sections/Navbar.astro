---

---

<div class="navbar-blur">
  <div class="navbar-wrap">
    <div class="navbar-glass">
      <div class="navbar-accent"></div>
      <a href="/" class="navbar-logo">
        <div class="logo-icon">
          <img src="/logo-icon.png" alt="" width="40" height="40" />
        </div>
        <div class="logo-text">
          <span class="logo-title">麦麦Bot</span>
          <span class="logo-subtitle">MaiBot MaiSaka</span>
        </div>
      </a>

      <div class="nav-divider"></div>

      <div class="nav-menu">
        <a href="https://github.com/Mai-with-u/MaiBot/blob/main/changelogs/changelog.md" class="nav-item">
          更新日志
          <svg class="nav-arrow" viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
            <path d="M12 15l-4.243-4.243 1.415-1.414L12 12.172l2.828-2.829 1.415 1.414z"></path>
          </svg>
        </a>
        <div class="nav-separator"></div>
        <a href="https://docs.mai-mai.org/" class="nav-item">
          使用文档
          <svg class="nav-arrow" viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
            <path d="M12 15l-4.243-4.243 1.415-1.414L12 12.172l2.828-2.829 1.415 1.414z"></path>
          </svg>
        </a>
        <div class="nav-separator"></div>
        <a href="#" data-modal="about" class="nav-item">
          关于我们
          <svg class="nav-arrow" viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
            <path d="M12 15l-4.243-4.243 1.415-1.414L12 12.172l2.828-2.829 1.415 1.414z"></path>
          </svg>
        </a>
      </div>

      <div class="nav-actions">
        <button class="theme-toggle" aria-label="切换深色模式">
          <svg
            class="icon-sun"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"
            ></line>
            <line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"
            ></line>
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
          </svg>
        </button>
        <button class="lang-switch" aria-label="切换语言" data-modal="lang">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor">
            <path
              d="M3.33333 10V11.3333C3.33333 12.0363 3.87725 12.6121 4.56716 12.663L4.66667 12.6667H6.66667V14H4.66667C3.19391 14 2 12.8061 2 11.3333V10H3.33333ZM12 6.66667L14.9333 14H13.4967L12.696 12H9.96933L9.17 14H7.734L10.6667 6.66667H12ZM11.3333 8.59013L10.502 10.6667H12.1633L11.3333 8.59013ZM5.33333 1.33333V2.66667H8V7.33333H5.33333V9.33333H4V7.33333H1.33333V2.66667H4V1.33333H5.33333ZM11.3333 2C12.8061 2 14 3.19391 14 4.66667V6H12.6667V4.66667C12.6667 3.93029 12.0697 3.33333 11.3333 3.33333H9.33333V2H11.3333ZM4 4H2.66667V6H4V4ZM6.66667 4H5.33333V6H6.66667V4Z"
            ></path>
          </svg>
        </button>
        <button class="nav-hamburger" aria-label="展开菜单" aria-expanded="false">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <span class="nav-cta-wrap">
          <a href="https://docs.mai-mai.org/manual/deployment/" class="nav-cta">部署</a>
        </span>
      </div>
    </div>

    <div class="nav-menu-mobile">
      <a href="https://github.com/Mai-with-u/MaiBot/blob/main/changelogs/changelog.md" class="nav-item-mobile"
        >更新日志</a
      >
      <a href="https://docs.mai-mai.org/" class="nav-item-mobile">使用文档</a>
      <a href="#" data-modal="about" class="nav-item-mobile">关于我们</a>
    </div>
  </div>
</div>

<style>
  /* === Layer 0: backdrop blur only === */
  .navbar-blur {
    position: fixed;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
  }

  /* === Layer 1: drop-shadow only === */
  .navbar-wrap {
    filter: drop-shadow(0 4px 20px rgba(0, 0, 0, 0.12));
    animation: fadeInDown 0.48s ease-out;
  }

  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* === Inner: cut corner + background === */
  .navbar-glass {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    width: 600px;
    height: 56px;
    padding: 0 12px;
    background: rgba(255, 255, 255, 0.7);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%);
  }

  .navbar-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: rgba(233, 127, 15, 0.85);
  }

  .navbar-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-left: 4px;
    text-decoration: none;
    color: inherit;
  }

  .logo-icon {
    width: 40px;
    height: 40px;
    border-radius: 16px;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: 0 4px 4px rgba(0, 0, 0, 0.25);
  }

  .logo-icon img {
    width: 40px;
    height: 40px;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .logo-title {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    color: #000;
    letter-spacing: 0.48px;
  }

  .logo-subtitle {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    color: #808080;
    letter-spacing: 0.36px;
  }

  .nav-divider {
    width: 1px;
    height: 24px;
    background: rgba(0, 0, 0, 0.12);
    transform: rotate(15deg);
    flex-shrink: 0;
  }

  .nav-menu {
    display: none;
    align-items: center;
    gap: 0;
    flex: 1;
  }

  .nav-separator {
    width: 1px;
    height: 16px;
    background: rgba(0, 0, 0, 0.08);
    flex-shrink: 0;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 6px 8px;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    color: #a2abbc;
    border-radius: 8px;
    transition: all var(--transition-fast);
    white-space: nowrap;
    text-decoration: none;
  }

  .nav-item:hover {
    color: var(--color-primary);
    background: rgba(233, 127, 15, 0.08);
  }

  .nav-arrow {
    opacity: 0.7;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .lang-switch {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    color: #a2abbc;
    border-radius: 8px;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .lang-switch:hover {
    color: var(--color-primary);
    background: rgba(233, 127, 15, 0.08);
  }

  /* theme toggle */
  .theme-toggle {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    color: #a2abbc;
    border-radius: 8px;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .theme-toggle:hover {
    color: var(--color-primary);
    background: rgba(233, 127, 15, 0.08);
  }

  .theme-toggle .icon-moon {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle .icon-sun {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle .icon-moon {
    display: block;
  }

  /* === Dark mode navbar === */
  :global([data-theme='dark']) .navbar-glass {
    background: rgba(28, 28, 28, 0.85);
  }

  :global([data-theme='dark']) .logo-title,
  :global([data-theme='dark']) .nav-hamburger,
  :global([data-theme='dark']) .nav-item-mobile {
    color: var(--c-text);
  }

  :global([data-theme='dark']) .logo-subtitle,
  :global([data-theme='dark']) .nav-item,
  :global([data-theme='dark']) .lang-switch,
  :global([data-theme='dark']) .theme-toggle {
    color: #fafafa;
  }

  :global([data-theme='dark']) .nav-divider,
  :global([data-theme='dark']) .nav-separator {
    background: rgba(255, 255, 255, 0.1);
  }

  :global([data-theme='dark']) .nav-item:hover,
  :global([data-theme='dark']) .lang-switch:hover,
  :global([data-theme='dark']) .theme-toggle:hover,
  :global([data-theme='dark']) .nav-item-mobile:hover {
    background: rgba(245, 148, 25, 0.12);
    color: var(--c-primary);
  }

  :global([data-theme='dark']) .nav-menu-mobile {
    background: rgba(38, 38, 38, 0.95);
  }

  /* deploy button */
  .nav-cta-wrap {
    display: inline-flex;
    flex-shrink: 0;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%);
    filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.2));
    transition: filter var(--transition-fast);
  }

  .nav-cta-wrap:hover {
    filter: drop-shadow(0 6px 24px rgba(0, 0, 0, 0.3));
  }

  .nav-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 20px;
    height: 40px;
    min-width: 84px;
    background: #e97f0f;
    color: #fff;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.48px;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .nav-cta-wrap:hover .nav-cta {
    background: #d06d0a;
    transform: translateY(-1px);
  }

  .nav-hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    background: transparent;
    color: #1b1b1b;
    border-radius: 8px;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .nav-hamburger:hover {
    background: rgba(233, 127, 15, 0.08);
    color: var(--color-primary);
  }

  .nav-menu-mobile {
    display: none;
    position: absolute;
    top: 80px;
    left: 0;
    right: 0;
    flex-direction: column;
    gap: 4px;
    padding: 8px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    z-index: 99;
  }

  .nav-menu-mobile.is-open {
    display: flex;
  }

  .nav-item-mobile {
    display: flex;
    align-items: center;
    padding: 10px 12px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    color: #1b1b1b;
    border-radius: 8px;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .nav-item-mobile:hover {
    background: rgba(233, 127, 15, 0.08);
    color: var(--color-primary);
  }

  @media (max-width: 639px) {
    .navbar-glass {
      width: auto;
      min-width: 300px;
      max-width: calc(100vw - 32px);
      gap: 6px;
      padding: 0 8px;
    }

    .nav-divider {
      display: none;
    }

    .logo-title {
      font-size: 14px;
    }

    .logo-subtitle {
      font-size: 10px;
    }

    .nav-cta {
      padding: 6px 14px;
      height: 36px;
      min-width: 0;
      font-size: 14px;
    }

    .nav-hamburger {
      display: flex;
    }
  }

  @media (min-width: 640px) {
    .nav-menu {
      display: flex;
    }
  }
</style>

<script>
  const logo = document.querySelector('.navbar-logo');
  if (logo) {
    logo.addEventListener('click', (e) => {
      if (window.location.pathname === '/' || window.location.pathname === '') {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  }

  const hamburger = document.querySelector('.nav-hamburger');
  const mobileMenu = document.querySelector('.nav-menu-mobile');
  if (hamburger && mobileMenu) {
    hamburger.addEventListener('click', () => {
      const open = mobileMenu.classList.toggle('is-open');
      hamburger.setAttribute('aria-expanded', String(open));
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.remove('is-open');
        hamburger.setAttribute('aria-expanded', 'false');
      });
    });
  }

  const themeToggle = document.querySelector('.theme-toggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const html = document.documentElement;
      const isDark = html.getAttribute('data-theme') === 'dark';
      const next = isDark ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    });
  }
</script>
