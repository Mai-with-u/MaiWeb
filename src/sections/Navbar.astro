---
import { Image } from 'astro:assets';
import logoIcon from '../assets/logo-icon.png';
import { links } from '../data/links';

// 当前页对应的导航项加 aria-current，屏幕阅读器能读出“当前页面”，样式上也高亮
const pathname = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => (pathname === href ? 'page' : undefined);
---

<div class="navbar-blur">
  <nav class="navbar-wrap" aria-label="主导航">
    <div class="navbar-glass">
      <div class="navbar-accent"></div>
      <a href="/" class="navbar-logo" aria-label="麦麦Bot 首页">
        <div class="logo-icon">
          <Image src={logoIcon} alt="" width={40} height={40} loading="eager" decoding="async" />
        </div>
        <div class="logo-text">
          <span class="logo-title">麦麦Bot</span>
          <span class="logo-subtitle">MaiBot MaiSaka</span>
        </div>
      </a>

      <div class="nav-divider"></div>

      <div class="nav-menu">
        <a href="/projects/" class="nav-item" aria-current={isCurrent('/projects/')}>衍生项目</a>
        <div class="nav-separator"></div>
        <div class="nav-dropdown">
          <button
            class="nav-item nav-dropdown-trigger"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="nav-docs-menu"
          >
            使用文档
            <svg class="nav-arrow" viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true">
              <path d="M12 15l-4.243-4.243 1.415-1.414L12 12.172l2.828-2.829 1.415 1.414z"></path>
            </svg>
          </button>
          <div class="nav-dropdown-menu" id="nav-docs-menu">
            <a href={links.manual} class="nav-dropdown-link">用户手册</a>
            <a href={links.develop} class="nav-dropdown-link">开发文档</a>
            <a href={links.faq} class="nav-dropdown-link">常见问题</a>
          </div>
        </div>
        <div class="nav-separator"></div>
        <a href="/about/" class="nav-item" aria-current={isCurrent('/about/')}>关于我们</a>
      </div>

      <div class="nav-actions">
        <button class="theme-toggle" type="button" aria-label="切换深色模式">
          <svg
            class="icon-sun"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"
            ></line>
            <line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"
            ></line>
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
          </svg>
        </button>
        <button
          class="nav-hamburger"
          type="button"
          aria-label="展开菜单"
          aria-expanded="false"
          aria-controls="nav-mobile-menu"
        >
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <span class="nav-cta-wrap">
          <a href={links.manual} class="nav-cta">部署</a>
        </span>
      </div>
    </div>

    <div class="nav-menu-mobile" id="nav-mobile-menu">
      <a href="/projects/" class="nav-item-mobile" aria-current={isCurrent('/projects/')}>衍生项目</a>
      <a href={links.manual} class="nav-item-mobile">用户手册</a>
      <a href={links.develop} class="nav-item-mobile">开发文档</a>
      <a href={links.faq} class="nav-item-mobile">常见问题</a>
      <a href="/about/" class="nav-item-mobile" aria-current={isCurrent('/about/')}>关于我们</a>
    </div>
  </nav>
</div>

<style>
  /* === Layer 0: backdrop blur only ===
     左右 0 + margin auto + fit-content 实现水平居中，不再用 transform 缩放（缩放会让文字发糊） */
  .navbar-blur {
    position: fixed;
    top: max(var(--safe-top), 16px);
    right: 0;
    left: 0;
    z-index: 100;
    width: fit-content;
    margin-inline: auto;
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
  }

  /* === Layer 1: drop-shadow only === */
  .navbar-wrap {
    filter: drop-shadow(0 4px 20px rgba(0, 0, 0, 0.12));
    animation: fadeInDown 0.48s ease-out;
  }

  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* === Inner: cut corner + background === */
  .navbar-glass {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    width: min(600px, calc(100vw - 32px - var(--safe-left) - var(--safe-right)));
    height: 56px;
    padding: 0 12px;
    background: transparent;
    isolation: isolate;
  }

  .navbar-glass::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: '';
    background: rgba(255, 255, 255, 0.7);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%);
  }

  .navbar-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: rgba(233, 127, 15, 0.85);
  }

  .navbar-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-left: 4px;
    text-decoration: none;
    color: inherit;
  }

  .logo-icon {
    width: 40px;
    height: 40px;
    border-radius: 16px;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: 0 4px 4px rgba(0, 0, 0, 0.25);
  }

  .logo-icon img {
    width: 40px;
    height: 40px;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .logo-title {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    color: #000;
    letter-spacing: 0.48px;
  }

  .logo-subtitle {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    color: #808080;
    letter-spacing: 0.36px;
  }

  .nav-divider {
    width: 1px;
    height: 24px;
    background: rgba(0, 0, 0, 0.12);
    transform: rotate(15deg);
    flex-shrink: 0;
  }

  .nav-menu {
    display: none;
    align-items: center;
    gap: 0;
    flex: 1;
  }

  .nav-separator {
    width: 1px;
    height: 16px;
    background: rgba(0, 0, 0, 0.08);
    flex-shrink: 0;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 6px 8px;
    border: none;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    color: #a2abbc;
    border-radius: 8px;
    transition: all var(--transition-fast);
    white-space: nowrap;
    text-decoration: none;
    background: transparent;
    cursor: pointer;
  }

  .nav-item:hover,
  .nav-dropdown.is-open .nav-dropdown-trigger,
  .nav-dropdown:focus-within .nav-dropdown-trigger {
    color: var(--c-primary);
    background: rgba(233, 127, 15, 0.08);
  }

  .nav-arrow {
    opacity: 0.7;
    transition: transform var(--transition-fast);
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    display: grid;
    min-width: 136px;
    padding: 8px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.14);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -6px);
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast);
  }

  .nav-dropdown-menu::before {
    position: absolute;
    top: -14px;
    left: 0;
    width: 100%;
    height: 14px;
    content: '';
  }

  .nav-dropdown.is-open .nav-dropdown-menu,
  .nav-dropdown:focus-within .nav-dropdown-menu {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .nav-dropdown.is-open .nav-arrow,
  .nav-dropdown:focus-within .nav-arrow {
    transform: rotate(180deg);
  }

  /* 只有能悬停的设备才在悬停时展开，触屏平板上靠点击切换，避免“点一下就卡在展开状态” */
  @media (hover: hover) {
    .nav-dropdown:hover .nav-dropdown-menu {
      opacity: 1;
      pointer-events: auto;
      transform: translate(-50%, 0);
    }

    .nav-dropdown:hover .nav-arrow {
      transform: rotate(180deg);
    }
  }

  /* 当前所在页面的导航项保持高亮 */
  .nav-item[aria-current='page'],
  .nav-item-mobile[aria-current='page'] {
    color: var(--c-primary);
  }

  .nav-dropdown-link {
    display: flex;
    align-items: center;
    padding: 9px 12px;
    border-radius: 10px;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    color: #1b1b1b;
    white-space: nowrap;
    transition: all var(--transition-fast);
  }

  .nav-dropdown-link:hover,
  .nav-dropdown-link:focus-visible {
    color: var(--c-primary);
    background: rgba(233, 127, 15, 0.08);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  /* theme toggle */
  .theme-toggle {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    color: #a2abbc;
    border-radius: 8px;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .theme-toggle:hover {
    color: var(--c-primary);
    background: rgba(233, 127, 15, 0.08);
  }

  .theme-toggle .icon-moon {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle .icon-sun {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle .icon-moon {
    display: block;
  }

  /* === Dark mode navbar === */
  :global([data-theme='dark']) .navbar-glass::before {
    background: rgba(28, 28, 28, 0.85);
  }

  :global([data-theme='dark']) .logo-title,
  :global([data-theme='dark']) .nav-hamburger,
  :global([data-theme='dark']) .nav-item-mobile {
    color: var(--c-text);
  }

  :global([data-theme='dark']) .logo-subtitle,
  :global([data-theme='dark']) .nav-item,
  :global([data-theme='dark']) .theme-toggle {
    color: #fafafa;
  }

  :global([data-theme='dark']) .nav-dropdown-menu {
    border-color: rgba(255, 255, 255, 0.08);
    background: rgba(38, 38, 38, 0.96);
  }

  :global([data-theme='dark']) .nav-dropdown-link {
    color: #fafafa;
  }

  :global([data-theme='dark']) .nav-divider,
  :global([data-theme='dark']) .nav-separator {
    background: rgba(255, 255, 255, 0.1);
  }

  :global([data-theme='dark']) .nav-item:hover,
  :global([data-theme='dark']) .nav-dropdown.is-open .nav-dropdown-trigger,
  :global([data-theme='dark']) .nav-dropdown:focus-within .nav-dropdown-trigger,
  :global([data-theme='dark']) .nav-dropdown-link:hover,
  :global([data-theme='dark']) .nav-dropdown-link:focus-visible,
  :global([data-theme='dark']) .theme-toggle:hover,
  :global([data-theme='dark']) .nav-item-mobile:hover {
    background: rgba(245, 148, 25, 0.12);
    color: var(--c-primary);
  }

  :global([data-theme='dark']) .nav-menu-mobile {
    background: rgba(38, 38, 38, 0.95);
  }

  /* deploy button */
  .nav-cta-wrap {
    display: inline-flex;
    flex-shrink: 0;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%);
    filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.2));
    transition: filter var(--transition-fast);
  }

  .nav-cta-wrap:hover {
    filter: drop-shadow(0 6px 24px rgba(0, 0, 0, 0.3));
  }

  .nav-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 20px;
    height: 40px;
    min-width: 84px;
    background: #e97f0f;
    color: #fff;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.48px;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .nav-cta-wrap:hover .nav-cta {
    background: #d06d0a;
    transform: translateY(-1px);
  }

  .nav-hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    background: transparent;
    color: #1b1b1b;
    border-radius: 8px;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .nav-hamburger:hover {
    background: rgba(233, 127, 15, 0.08);
    color: var(--c-primary);
  }

  .nav-menu-mobile {
    display: none;
    position: absolute;
    top: calc(100% + 12px);
    left: 0;
    right: 0;
    flex-direction: column;
    gap: 4px;
    padding: 8px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    z-index: 99;
  }

  .nav-item-mobile {
    display: flex;
    align-items: center;
    padding: 10px 12px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    color: #1b1b1b;
    border-radius: 8px;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .nav-item-mobile:hover {
    background: rgba(233, 127, 15, 0.08);
    color: var(--c-primary);
  }

  /* 窄屏（< 768px）：收起文字菜单，改用汉堡按钮展开下拉面板 */
  @media (max-width: 767.98px) {
    .navbar-glass {
      width: auto;
      min-width: min(300px, calc(100vw - 32px - var(--safe-left) - var(--safe-right)));
      max-width: calc(100vw - 32px - var(--safe-left) - var(--safe-right));
      gap: 6px;
      padding: 0 8px;
    }

    .nav-divider {
      display: none;
    }

    .logo-title {
      font-size: 14px;
    }

    .logo-subtitle {
      font-size: 10px;
    }

    .nav-cta {
      height: 36px;
      min-width: 0;
      padding: 6px 14px;
      font-size: 14px;
    }

    .nav-hamburger {
      display: flex;
    }

    .nav-menu-mobile.is-open {
      display: flex;
    }
  }

  /* 宽屏（>= 768px）：展示完整文字菜单 */
  @media (min-width: 768px) {
    .nav-menu {
      display: flex;
    }
  }

  /* 触屏设备把图标按钮放大，接近 44px 的推荐点击尺寸 */
  @media (pointer: coarse) {
    .theme-toggle,
    .nav-hamburger {
      width: 40px;
      height: 40px;
    }
  }

  /* 超大屏整体放大导航栏；zoom 会重新排版而不是位图缩放，文字保持清晰 */
  @media (min-width: 1920px) {
    .navbar-blur {
      zoom: 1.125;
    }
  }

  @media (min-width: 2560px) {
    .navbar-blur {
      zoom: 1.25;
    }
  }
</style>

<script>
  const logo = document.querySelector('.navbar-logo');
  if (logo) {
    logo.addEventListener('click', (e) => {
      if (window.location.pathname === '/' || window.location.pathname === '') {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  }

  const dropdown = document.querySelector<HTMLElement>('.nav-dropdown');
  const dropdownTrigger = dropdown?.querySelector<HTMLButtonElement>('.nav-dropdown-trigger');
  const dropdownMenu = dropdown?.querySelector<HTMLElement>('.nav-dropdown-menu');
  const dropdownLinks = dropdownMenu?.querySelectorAll<HTMLAnchorElement>('a');
  if (dropdown && dropdownTrigger && dropdownMenu) {
    const closeDropdown = () => {
      dropdown.classList.remove('is-open');
      dropdownTrigger.setAttribute('aria-expanded', 'false');
    };

    const openDropdown = () => {
      dropdown.classList.add('is-open');
      dropdownTrigger.setAttribute('aria-expanded', 'true');
    };

    dropdownTrigger.addEventListener('click', () => {
      const isOpen = dropdown.classList.contains('is-open');
      if (isOpen) {
        closeDropdown();
      } else {
        openDropdown();
      }
    });

    dropdownTrigger.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        openDropdown();
        dropdownLinks?.[0]?.focus();
      }
    });

    dropdown.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        closeDropdown();
        dropdownTrigger.focus();
      }
    });

    dropdownLinks?.forEach((link) => {
      link.addEventListener('click', closeDropdown);
    });

    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node)) {
        closeDropdown();
      }
    });
  }

  // 汉堡菜单：点击按钮展开或收起；点菜单里的链接、按 Esc、点菜单外部、或窗口变宽到显示完整菜单时自动收起
  const hamburger = document.querySelector<HTMLButtonElement>('.nav-hamburger');
  const mobileMenu = document.querySelector<HTMLElement>('.nav-menu-mobile');
  if (hamburger && mobileMenu) {
    const setMobileMenu = (open: boolean) => {
      mobileMenu.classList.toggle('is-open', open);
      hamburger.setAttribute('aria-expanded', String(open));
      hamburger.setAttribute('aria-label', open ? '收起菜单' : '展开菜单');
    };

    hamburger.addEventListener('click', () => setMobileMenu(!mobileMenu.classList.contains('is-open')));

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMobileMenu(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileMenu.classList.contains('is-open')) {
        setMobileMenu(false);
        hamburger.focus();
      }
    });

    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!mobileMenu.contains(target) && !hamburger.contains(target)) setMobileMenu(false);
    });

    window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
      if (e.matches) setMobileMenu(false);
    });
  }

  const themeToggle = document.querySelector('.theme-toggle');
  if (themeToggle) {
    // 点击切换主题：先临时挂上过渡类让颜色平滑变化，切换完成后再移除，平时不影响其他动效
    let switchTimer: ReturnType<typeof setTimeout> | undefined;
    themeToggle.addEventListener('click', () => {
      const html = document.documentElement;
      const isDark = html.getAttribute('data-theme') === 'dark';
      const next = isDark ? 'light' : 'dark';
      html.classList.add('theme-switching');
      html.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        // 隐私模式下可能无法写入，本次切换照样生效，只是刷新后不记忆
      }
      clearTimeout(switchTimer);
      switchTimer = setTimeout(() => html.classList.remove('theme-switching'), 400);
    });
  }
</script>
