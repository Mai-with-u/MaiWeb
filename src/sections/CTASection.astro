---
import CtaButton from '../components/CtaButton.astro';
---

<section class="cta-section" id="cta">
  <div class="container cta-inner reveal">
    <h2 class="cta-title title-orange">你想要的,一切尽在 MaiSaka!</h2>
    <h2 class="cta-title title-dark">一个致力于了解你的数字生命。</h2>

    <div class="cta-action reveal-delay-1">
      <CtaButton
        variant="primary"
        size="large"
        href="https://docs.mai-mai.org/manual/deployment/"
        icon="paperplane"
        label="现在开始"
      />
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    min-height: calc(100vh - 160px);
    padding: 165px 0 0px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .cta-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 6vw, 72px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 3.6px;
  }

  .title-orange {
    color: var(--c-primary);
  }

  .title-dark {
    color: var(--color-dark);
  }

  .cta-action {
    margin-top: 32px;
  }

  .cta-action :global(.cta-btn-primary) {
    min-width: 194px;
    min-height: 71px;
  }

  @media (max-width: 768px) {
    .cta-section {
      padding: 165px 0 0px;
    }
  }
</style>
