---
import CtaButton from '../components/CtaButton.astro';

const oneKeyUrl = 'https://api.github.com/repos/Mai-with-u/MaiBotOneKey/releases/latest';
let downloadUrl = 'https://github.com/Mai-with-u/MaiBotOneKey/releases/latest';
try {
  const res = await fetch(oneKeyUrl, { headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'MaiWeb/1.0' } });
  if (res.ok) {
    const data = await res.json();
    if (data.assets?.length > 0) downloadUrl = data.assets[0].browser_download_url;
  }
} catch {}
---

<section class="cta-section" id="cta">
  <div class="container cta-inner reveal">
    <h2 class="cta-title title-orange">你想要的,一切尽在 MaiSaka!</h2>
    <h2 class="cta-title title-dark">一个致力于了解你的数字生命。</h2>

    <div class="cta-action reveal-delay-1">
      <CtaButton
        variant="primary"
        size="large"
        href={downloadUrl}
        icon="paperplane"
        label="现在开始"
      />
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    padding: 120px 0 100px;
    margin-top: 10rem;
    margin-bottom: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .cta-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 6vw, 72px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 3.6px;
  }

  .title-orange {
    color: var(--c-primary);
  }

  .title-dark {
    color: var(--color-dark);
  }

  .cta-action {
    margin-top: 32px;
  }

  .cta-action :global(.cta-btn-primary) {
    min-width: 194px;
    min-height: 71px;
  }

  @media (max-width: 768px) {
    .cta-section {
      margin-top: 4rem;
      padding: 80px 0 60px;
    }
  }
</style>
