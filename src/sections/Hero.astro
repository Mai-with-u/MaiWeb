---
import { useI18n } from '../lib/i18n';
import { getImage } from 'astro:assets';
import CtaButton from '../components/CtaButton.astro';
import QqGroupsDialog from '../components/dialog/QqGroupsDialog.astro';
import VersionsDialog from '../components/dialog/VersionsDialog.astro';
import DownloadSourcesDialog from '../components/dialog/DownloadSourcesDialog.astro';
import heroImage from '../assets/maimai-v2.png';
import { links } from '../data/links';
const { t } = useI18n(Astro.url);

// 首屏布局：单栏（手机、竖屏平板、横屏手机）只放文案和按钮，占满一屏并垂直居中；
// 宽屏（>= 1024px 且宽高比 >= 5:4）切成左右两栏，右侧才显示立绘，并按 1600×900 设计稿等比缩放。
// 断点全部写在 CSS 里，首帧就是最终布局。

// 立绘只在两栏布局出现：用 <picture> 的 media 条件只给宽屏提供图片地址，
// 单栏时 <img> 落到 1×1 的占位图，手机不会白白下载被隐藏的立绘。
const heroImageSet = await getImage({ src: heroImage, widths: [480, 640, 820], format: 'webp' });
const placeholder = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-content">
      <h1 class="hero-title animate-fade-in">
        <span class="title-line">
          {t('我在')}
          <span class="title-underline">{t('试着学习')}</span>
        </span>
        <span class="title-line">
          {t('像人类一样')}
          <span class="title-highlight">{t('陪伴你')}</span>
        </span>
      </h1>

      <p class="hero-subtitle animate-fade-in animate-delay-2">
        {t('泥壕! 我是')}
        <span class="subtitle-highlight">{t('麦麦')}</span>
        {t('，一个正在努力成为人类的BOT。')}
      </p>

      <div class="hero-buttons">
        <CtaButton
          variant="primary"
          size="large"
          id="hero-download"
          dialog="download-sources"
          href={links.oneKeyLatest}
          icon="download"
          label={t('立即下载')}
          sublabel={t('Windows 一键包')}
          delay={0.3}
        />
        <div class="hero-buttons-row">
          <CtaButton
            variant="green"
            size="small"
            href={links.manual}
            icon="download"
            label={t('其他部署方式')}
            dialog="versions"
            delay={0.4}
          />
          <CtaButton variant="green" size="small" href={links.docs} icon="docs" label={t('使用文档')} delay={0.5} />
          <CtaButton
            variant="green"
            size="small"
            href={links.community}
            icon="qq"
            label={t('加入社区')}
            dialog="qq"
            delay={0.6}
          />
          <CtaButton variant="green" size="small" href={links.repo} icon="github" label="GitHub" delay={0.7} />
        </div>
      </div>
    </div>

    <div class="hero-visual animate-fade-in animate-delay-4">
      <svg class="star-bg" viewBox="0 0 648 648" aria-hidden="true">
        <polygon
          points="324,24 398,240 624,240 438,376 510,600 324,470 138,600 210,376 24,240 250,240"
          fill="none"
          stroke="currentColor"
          stroke-width="48"
          stroke-linejoin="round"
        ></polygon>
      </svg>
      <picture>
        <source
          media="(min-width: 1024px) and (min-aspect-ratio: 5/4)"
          srcset={heroImageSet.srcSet.attribute}
          sizes="26rem"
          type="image/webp"
        />
        <img
          src={placeholder}
          alt={t('麦麦')}
          class="character-img"
          width={heroImage.width}
          height={heroImage.height}
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <a class="version-card" id="hero-release" href={links.latestRelease} target="_blank" rel="noopener noreferrer">
        <span class="version-label">.Version</span>
        <span class="version-text">{t('获取中……')}</span>
      </a>
    </div>
  </div>
</section>

<QqGroupsDialog />
<VersionsDialog />
<DownloadSourcesDialog />

<script>
  import { getDownloadPlatform } from '../lib/download-platform';
  import { translator } from '../lib/i18n';
  const t = translator(document.documentElement.lang === 'en' ? 'en' : 'zh-CN');
  import { links, releaseApis } from '../data/links';

  // 首屏下载按钮与版本号：页面加载后在浏览器端查询 GitHub Releases。
  // 顺序：按 UA 判断平台 -> 先用会话缓存或发布页兜底填好链接 -> 并行查询核心版本、Windows 一键包、Android 安装包
  //      -> 查到后回填按钮、“其他版本”弹窗和版本卡片，并写入会话缓存。
  // 放在浏览器端而不是构建时，是为了让 CDN 上的静态页面始终显示最新版本，不受构建时间影响。
  type Platform = 'windows' | 'android';
  type ReleaseAsset = { name?: string; browser_download_url?: string; state?: string };
  type GitHubRelease = {
    tag_name?: string;
    name?: string;
    html_url?: string;
    draft?: boolean;
    published_at?: string;
    created_at?: string;
    assets?: ReleaseAsset[];
  };
  type DownloadInfo = { url: string; version?: string };
  type DownloadCache = Partial<Record<Platform, DownloadInfo>>;

  const CACHE_KEY = 'maisaka-download-links-v2';
  const fallback: Record<Platform, DownloadInfo> = {
    windows: { url: links.oneKeyLatest },
    android: { url: links.droidReleases },
  };
  const platform = getDownloadPlatform(navigator.userAgent, navigator.maxTouchPoints);
  // 弹窗隐藏首页已经推荐的安装包；没有对应客户端的设备显示全部部署选项。
  document.documentElement.dataset.downloadPlatform = platform;

  function isGitHubUrl(value: string | undefined): value is string {
    if (!value) return false;
    try {
      const url = new URL(value);
      return url.protocol === 'https:' && (url.hostname === 'github.com' || url.hostname.endsWith('.github.com'));
    } catch {
      return false;
    }
  }

  function readCache(): DownloadCache {
    try {
      return JSON.parse(sessionStorage.getItem(CACHE_KEY) || '{}') as DownloadCache;
    } catch {
      return {};
    }
  }

  function writeCache(cache: DownloadCache) {
    try {
      sessionStorage.setItem(CACHE_KEY, JSON.stringify(cache));
    } catch {
      // 隐私模式下可能无法写入，链接照样可用，只是下次进入要重新查询
    }
  }

  async function fetchJson<T>(url: string): Promise<T | undefined> {
    try {
      const response = await fetch(url, { headers: { Accept: 'application/vnd.github+json' } });
      return response.ok ? ((await response.json()) as T) : undefined;
    } catch {
      return undefined;
    }
  }

  const uploaded = (release: GitHubRelease) =>
    (release.assets || []).filter((asset) => !asset.state || asset.state === 'uploaded');

  // Windows 一键包：取发布里的 .exe 安装程序
  function findWindowsAsset(release: GitHubRelease) {
    return uploaded(release).find((asset) => /\.exe$/i.test(asset.name || ''));
  }

  // Android：排除 debug / unsigned 包，优先“maidroid_版本号.apk”，其次 universal 包，都没有时只在唯一候选时采用
  function findAndroidAsset(release: GitHubRelease) {
    const candidates = uploaded(release).filter(
      (asset) => /\.apk$/i.test(asset.name || '') && !/(debug|unsigned)/i.test(asset.name || '')
    );
    const canonical = release.tag_name ? `maidroid_${release.tag_name}.apk`.toLowerCase() : '';
    return (
      candidates.find((asset) => (asset.name || '').toLowerCase() === canonical) ||
      candidates.find((asset) => /universal/i.test(asset.name || '')) ||
      (candidates.length === 1 ? candidates[0] : undefined)
    );
  }

  function toDownload(
    release: GitHubRelease | undefined,
    find: (_release: GitHubRelease) => ReleaseAsset | undefined
  ): DownloadInfo | undefined {
    const url = release && find(release)?.browser_download_url;
    if (!release || !isGitHubUrl(url)) return undefined;
    return { url, version: release.tag_name || release.name };
  }

  async function resolveAndroid(): Promise<DownloadInfo | undefined> {
    // MaiDroid 目前只有预发布版本，/releases/latest 查不到，所以取最近 10 个发布按时间倒序找第一个可用安装包
    const releases = (await fetchJson<GitHubRelease[]>(releaseApis.droid)) || [];
    const sorted = releases
      .filter((release) => !release.draft)
      .sort(
        (a, b) =>
          (Date.parse(b.published_at || b.created_at || '') || 0) -
          (Date.parse(a.published_at || a.created_at || '') || 0)
      );
    for (const release of sorted) {
      const download = toDownload(release, findAndroidAsset);
      if (download) return download;
    }
    return undefined;
  }

  const downloads = readCache();

  function applyDownloads() {
    const resolve = (target: Platform) => {
      const cached = downloads[target];
      return cached && isGitHubUrl(cached.url) ? cached : fallback[target];
    };

    // 主按钮：按当前平台切换下载地址和副标题
    const main = document.getElementById('hero-download') as HTMLAnchorElement | null;
    if (main) {
      const deploymentOnly = platform === 'deployment';
      const title = t(deploymentOnly ? '查看部署方式' : '立即下载');
      const label = deploymentOnly ? '' : t(platform === 'android' ? 'Android 安装包' : 'Windows 一键包');
      main.href = deploymentOnly ? links.manual : resolve(platform).url;
      main.setAttribute('aria-label', label ? `${title} ${label}` : title);
      const titleElement = main.querySelector('.cta-label');
      if (titleElement) titleElement.textContent = title;
      if (platform !== 'android') {
        main.dataset.dialog = deploymentOnly ? 'versions' : 'download-sources';
        main.setAttribute('aria-haspopup', 'dialog');
        main.setAttribute('aria-controls', deploymentOnly ? 'dialog-versions' : 'dialog-download-sources');
      } else {
        delete main.dataset.dialog;
        main.removeAttribute('aria-haspopup');
        main.removeAttribute('aria-controls');
      }
      const sublabel = main.querySelector<HTMLElement>('.cta-sublabel');
      if (sublabel) {
        sublabel.textContent = label;
        sublabel.hidden = deploymentOnly;
      }
    }

    // “其他版本”弹窗：两个平台的下载地址和版本号
    document.querySelectorAll<HTMLAnchorElement>('a[data-download]').forEach((link) => {
      link.href = resolve(link.dataset.download === 'android' ? 'android' : 'windows').url;
    });
    document.querySelectorAll<HTMLElement>('[data-download-version]').forEach((label) => {
      const version = downloads[label.dataset.downloadVersion === 'android' ? 'android' : 'windows']?.version;
      if (version) label.textContent = `${t('版本')} ${version}`;
    });
  }

  applyDownloads();

  // 版本信息：显示核心最新版本号，点击可查看该版本的发布说明。
  const coreVersion = fetchJson<GitHubRelease>(releaseApis.core).then((release) => {
    const version = (release?.tag_name || release?.name)?.replace(/^v/, '');
    const versionText = document.querySelector('.version-text');
    // 查不到版本（例如 GitHub 接口限流）时，直接引导去发布页。
    if (versionText) versionText.textContent = version || t('查看最新版本');
    const releaseLink = document.getElementById('hero-release') as HTMLAnchorElement | null;
    if (releaseLink && isGitHubUrl(release?.html_url)) releaseLink.href = release.html_url;
  });

  const windows = downloads.windows
    ? Promise.resolve()
    : fetchJson<GitHubRelease>(releaseApis.oneKey).then((release) => {
        const download = toDownload(release, findWindowsAsset);
        if (download) downloads.windows = download;
      });
  const android = downloads.android
    ? Promise.resolve()
    : resolveAndroid().then((download) => {
        if (download) downloads.android = download;
      });

  Promise.allSettled([coreVersion, windows, android]).then(() => {
    writeCache(downloads);
    applyDownloads();
  });
</script>

<style>
  /* 首屏至少占满一屏，内容在导航栏下方的可视区域里垂直居中 */
  .hero {
    position: relative;
    display: flex;
    min-height: 100vh;
    min-height: 100svh;
    align-items: center;
    padding: calc(var(--nav-offset) + 0.5rem) 0 1.5rem;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 35rem;
  }

  .hero-title {
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
    color: var(--text-strong);
    font-size: clamp(2.25rem, 1.5rem + 3.4vw, 3.625rem);
    line-height: 1.25;
  }

  .title-line {
    display: block;
  }

  .title-highlight {
    color: var(--c-primary);
  }

  .title-underline {
    text-decoration: underline;
    text-decoration-color: var(--c-green);
    text-decoration-thickness: 0.14em;
    text-decoration-skip-ink: none;
    text-underline-offset: 0.1em;
  }

  .hero-subtitle {
    margin-bottom: clamp(1.375rem, 3vw, 2rem);
    color: var(--text-strong);
    font-family: 'Times New Roman', Times, serif;
    font-size: var(--fs-lead);
    line-height: 1.5;
  }

  :global(html[lang='en']) .hero-subtitle {
    font-family: var(--font-body);
  }

  :global(html[lang='en']) .hero-title {
    font-size: clamp(1.875rem, 8vw, 3.625rem);
    letter-spacing: -0.025em;
  }

  :global(html[lang='en']) .title-highlight {
    white-space: nowrap;
  }

  :global(html[lang='en']) .hero-buttons-row :global(.cta-link-small) {
    min-width: 0;
    gap: 0.5rem;
    padding: 0.625rem 0.75rem;
  }

  .subtitle-highlight {
    margin-inline: 0.15em;
    color: var(--c-primary);
    font-family: var(--font-display);
    font-weight: 700;
  }

  .hero-buttons {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.625rem;
  }

  .hero-buttons-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(100%, 24rem);
    gap: 0.625rem 0.75rem;
  }

  .hero-buttons-row :global(.cta-blur),
  .hero-buttons-row :global(.cta-wrap),
  .hero-buttons-row :global(.cta-clip),
  .hero-buttons-row :global(.cta-link-small) {
    width: 100%;
    min-width: 0;
  }

  .hero-buttons-row :global(.cta-link-small) {
    gap: 0.5rem;
    padding-inline: 0.625rem;
  }

  .hero-buttons-row :global(.cta-label) {
    font-size: clamp(0.875rem, 3.5vw, 1rem);
  }

  /* 立绘区：按设计稿 648×724 的比例留出画布，星形背景铺满，人物宽度占 63% 正好撑满高度 */
  /* 立绘区只在宽屏两栏出现，单栏布局直接隐藏 */
  .hero-visual {
    position: relative;
    display: none;
  }

  .star-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: auto;
    margin: auto;
    color: #f0f0f0;
    pointer-events: none;
  }

  :global([data-theme='dark']) .star-bg {
    color: #2b2b2b;
  }

  /* <picture> 默认是行内元素，作为 flex 子项时会被图片固有尺寸撑开；
     人物宽度必须设在 picture 上，img 再撑满 picture，百分比才会相对立绘区计算 */
  .hero-visual picture {
    position: relative;
    z-index: 1;
    display: block;
  }

  .character-img {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 0.25rem 0.25rem rgba(0, 0, 0, 0.25));
    animation: float 4s ease-in-out infinite;
  }

  /* 版本信息放在立绘区右下角，以粗体橙色文字链接展示。 */
  .version-card {
    position: absolute;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    padding: 0.5rem 0;
    color: var(--c-primary);
    text-align: left;
    font-family: var(--font-display);
    font-weight: 900;
    opacity: 0.85;
    transition:
      transform var(--transition-fast),
      opacity var(--transition-fast);
  }

  .version-card:hover,
  .version-card:focus-visible {
    transform: translateY(-2px);
    opacity: 1;
  }

  .version-card:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 0.375rem;
  }

  .version-label,
  .version-text {
    display: block;
    white-space: nowrap;
  }

  .version-label {
    font-size: 1.125rem;
    line-height: 1.2;
    letter-spacing: 0.06em;
  }

  .version-text {
    font-size: 2.25rem;
    line-height: 1.1;
    letter-spacing: -0.04em;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .version-card:hover .version-text,
  .version-card:focus-visible .version-text {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* 宽屏两栏（与 global.css 的等比缩放条件一致）：
     所有尺寸取改造前 1600×900 时的实测值并写成 rem，根字号缩放时整屏构图同比例缩放：
     首屏上下内边距 80px；文案 554px + 间距 48px + 立绘区 648×724px；
     人物宽 407px 居中；星形 648px 居中；版本信息放在立绘区右下角的留白处 */
  @media (min-width: 1024px) and (min-aspect-ratio: 5/4) {
    .hero {
      padding: max(5rem, calc(4.5rem + var(--safe-top))) 0 5rem;
    }

    .hero-inner {
      grid-template-columns: minmax(0, 34.625rem) minmax(0, 40.5rem);
      align-items: center;
      justify-content: center;
      gap: 3rem;
    }

    .hero-content {
      max-width: none;
    }

    .hero-title,
    :global(html[lang='en']) .hero-title {
      margin-bottom: 1.625rem;
      font-size: 3.875rem;
      line-height: normal;
    }

    .title-line {
      white-space: nowrap;
    }

    .hero-subtitle {
      margin-bottom: 2.125rem;
      font-size: 1.375rem;
    }

    .hero-buttons {
      gap: 0.75rem;
    }

    /* 首屏按钮略微放大，四个次要入口以两行两列对齐。 */
    .hero-buttons :global(.cta-link-large) {
      min-width: 13.125rem;
      min-height: 4.8125rem;
      padding: 0.9375rem 1.375rem 0.9375rem 1.25rem;
    }

    .hero-buttons :global(.cta-wrap-large .cta-label) {
      font-size: 1.625rem;
    }

    .hero-buttons :global(.cta-wrap-large .cta-sublabel) {
      font-size: 1.0625rem;
    }

    .hero-buttons :global(.cta-wrap-large .cta-icon) {
      width: 2.4375rem;
      height: 2.4375rem;
    }

    .hero-buttons-row :global(.cta-link-small) {
      min-height: 3.0625rem;
      gap: 0.625rem;
      padding-block: 0.6875rem;
    }

    .hero-buttons-row :global(.cta-label) {
      font-size: 1.0625rem;
    }

    .hero-buttons-row :global(.cta-icon) {
      width: 1.375rem;
      height: 1.375rem;
    }

    .hero-buttons-row {
      gap: 0.75rem;
    }

    /* 立绘区用 flex 居中，人物宽度按立绘区宽度的百分比计算（设计稿 407 / 648）：
       百分比必须落在尺寸确定的容器上，否则会先按图片固有宽度定尺寸，人物变成一个不随窗口缩放的固定值 */
    .hero-visual {
      display: flex;
      width: min(100%, 40.5rem);
      aspect-ratio: 648 / 724;
      align-items: center;
      justify-content: center;
    }

    .hero-visual picture {
      width: calc(407 / 648 * 100%);
    }

    .version-card {
      right: 1rem;
      bottom: 1rem;
    }
  }

  /* 横屏手机高度很小：标题和间距按视口高度收紧，尽量让按钮留在首屏内 */
  @media (max-width: 1023.98px) and (max-height: 600px) and (orientation: landscape) {
    .hero-title {
      font-size: clamp(1.75rem, 1rem + 4vh, 2.5rem);
    }

    .hero-subtitle {
      margin-bottom: 1rem;
    }
  }
</style>
