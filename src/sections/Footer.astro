---
import { Image } from 'astro:assets';
import easterEgg from '../assets/easter-egg.png';
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="footer-copyright">
      MaiSaka 以 <a
        href="https://github.com/Mai-with-u/MaiBot/blob/main/LICENSE"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link">GPL-3.0</a
      > 协议开源；使用即表示您同意并知悉<a
        href="https://github.com/Mai-with-u/MaiBot/blob/main/EULA.md"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link">「用户协议」</a
      >和<a
        href="https://github.com/Mai-with-u/MaiBot/blob/main/PRIVACY.md"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link">「隐私协议」</a
      >的相关内容。<br /> AI 生成内容请仔细甄别。
    </p>
    <p class="footer-credit"></p>
  </div>

  <div class="easter-egg" role="button" aria-label="彩蛋" tabindex="-1">
    <Image src={easterEgg} alt="" width={120} height={120} />
  </div>
  <div class="easter-bubble">
    <span class="easter-bubble-text">麦麦说得对</span>
  </div>
</footer>

<script>
  const egg = document.querySelector('.easter-egg') as HTMLElement | null;
  const bubble = document.querySelector('.easter-bubble') as HTMLElement | null;
  if (egg && bubble) {
    let timerShow: ReturnType<typeof setTimeout> | null = null;
    let timerHide: ReturnType<typeof setTimeout> | null = null;
    let timerReset: ReturnType<typeof setTimeout> | null = null;

    const clearTimers = () => {
      if (timerShow) clearTimeout(timerShow);
      if (timerHide) clearTimeout(timerHide);
      if (timerReset) clearTimeout(timerReset);
      timerShow = timerHide = timerReset = null;
    };

    const trigger = () => {
      if (egg.classList.contains('is-rising')) return;
      clearTimers();
      egg.classList.add('is-rising');
      // 彩蛋浮到顶点后气泡从左滑入
      timerShow = setTimeout(() => bubble.classList.add('is-visible'), 500);
      // 彩蛋开始下降前气泡滑出
      timerHide = setTimeout(() => bubble.classList.remove('is-visible'), 3500);
      // 动画结束复位
      timerReset = setTimeout(() => {
        egg.classList.remove('is-rising');
        bubble.classList.remove('is-visible');
      }, 4000);
    };

    egg.addEventListener('click', trigger);
    // Keep keydown for keyboard users who tab to the element via tabindex=-1 still allows programmatic focus
  }
</script>

<style>
  .footer {
    position: relative;
    min-height: 160px;
    padding: 40px 0 max(60px, var(--safe-bottom));
    text-align: center;
    overflow: hidden;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .footer-copyright {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    color: var(--color-text-muted);
    letter-spacing: 0.36px;
    line-height: 1.5;
    max-width: 640px;
  }

  .footer-link {
    color: var(--c-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer-link:hover {
    color: var(--c-primary-hover);
  }

  .footer-credit {
    font-family: 'HarmonyOS Sans SC', 'PingFang SC', 'Microsoft YaHei', sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: #000;
  }

  :global([data-theme='dark']) .footer-credit {
    color: var(--c-text);
  }

  .easter-egg {
    position: absolute;
    left: 15%;
    bottom: -95px;
    width: 120px;
    height: 120px;
    transform: translateX(-50%);
    border-radius: 16px;
    overflow: visible;
    cursor: pointer;
    z-index: 2;
    transition: filter 0.2s ease;
  }

  .easter-egg:hover {
    filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.2));
  }

  .easter-egg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
    border-radius: 16px;
  }

  .easter-egg.is-rising {
    animation: easterRise 4s ease-in-out forwards;
    pointer-events: none;
  }

  @keyframes easterRise {
    0% {
      transform: translateX(-50%) translateY(0);
    }
    12.5%,
    87.5% {
      transform: translateX(-50%) translateY(calc(-95px * var(--ui-scale)));
    }
    100% {
      transform: translateX(-50%) translateY(0);
    }
  }

  .easter-bubble {
    position: absolute;
    left: 15%;
    bottom: -64px;
    transform: translateX(calc(-50% + 138px)) translateY(-95px);
    z-index: 2;
    pointer-events: none;
  }

  .easter-bubble-text {
    display: inline-block;
    font-family: 'HarmonyOS Sans SC', 'PingFang SC', 'Microsoft YaHei', sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
    padding: 12px 18px;
    border-radius: 20px;
    border-bottom-left-radius: 4px;
    background: #eeeef0;
    color: #2b2b2b;
    opacity: 0;
    transform: translateX(-30px) scale(0.92);
    transition:
      opacity 0.24s ease-out,
      transform 0.24s ease-out;
  }

  .easter-bubble.is-visible .easter-bubble-text {
    opacity: 1;
    transform: translateX(0) scale(1);
  }

  :global([data-theme='dark']) .easter-bubble-text {
    background: #3a3a3c;
    color: #f9fafc;
  }

  :global(html[data-layout='wide']) .footer {
    min-height: calc(160px * var(--ui-scale));
    padding-top: calc(40px * var(--ui-scale));
    padding-bottom: max(calc(60px * var(--ui-scale)), var(--safe-bottom));
  }

  :global(html[data-layout='wide']) .footer-inner {
    gap: calc(12px * var(--ui-scale));
  }

  :global(html[data-layout='wide']) .footer-copyright,
  :global(html[data-layout='wide']) .footer-credit {
    font-size: clamp(10px, calc(12px * var(--ui-scale)), 19.2px);
  }

  :global(html[data-layout='wide']) .footer-copyright {
    max-width: calc(640px * var(--ui-scale));
  }

  :global(html[data-layout='wide']) .easter-egg {
    bottom: calc(-95px * var(--ui-scale));
    width: calc(120px * var(--ui-scale));
    height: calc(120px * var(--ui-scale));
    border-radius: calc(16px * var(--ui-scale));
  }

  :global(html[data-layout='wide']) .easter-egg img {
    border-radius: calc(16px * var(--ui-scale));
  }

  :global(html[data-layout='wide']) .easter-bubble {
    bottom: calc(-64px * var(--ui-scale));
    transform: translateX(calc(-50% + 138px * var(--ui-scale))) translateY(calc(-95px * var(--ui-scale)));
  }

  :global(html[data-layout='wide']) .easter-bubble-text {
    padding: calc(12px * var(--ui-scale)) calc(18px * var(--ui-scale));
    border-radius: calc(20px * var(--ui-scale));
    border-bottom-left-radius: calc(4px * var(--ui-scale));
    font-size: clamp(10px, calc(16px * var(--ui-scale)), 25.6px);
  }

  :global(html[data-layout='compact']) .easter-egg {
    left: max(15%, var(--safe-left));
    width: 80px;
    height: 80px;
    bottom: -60px;
  }

  :global(html[data-layout='compact']) .easter-egg.is-rising {
    animation-name: easterRiseCompact;
  }

  :global(html[data-layout='compact']) .easter-bubble {
    bottom: -40px;
    transform: translateX(calc(-50% + 100px)) translateY(-60px);
  }

  :global(html[data-layout='compact']) .easter-bubble-text {
    font-size: 13px;
    padding: 8px 12px;
    border-radius: 12px;
    border-bottom-left-radius: 3px;
    max-width: 160px;
  }

  @keyframes easterRiseCompact {
    0% {
      transform: translateX(-50%) translateY(0);
    }
    12.5%,
    87.5% {
      transform: translateX(-50%) translateY(-60px);
    }
    100% {
      transform: translateX(-50%) translateY(0);
    }
  }
</style>
