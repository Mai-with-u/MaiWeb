---
import { useI18n } from '../lib/i18n';
import { Image } from 'astro:assets';
import easterEgg from '../assets/easter-egg-complete.png';
import { links } from '../data/links';
const { locale, t, localPath } = useI18n(Astro.url);

// 页脚：常用入口 + 开源协议说明。左下角藏着一个只用鼠标或手指才能点到的彩蛋。
// Astro 7 起模板按 JSX 规则处理空白：跨行的空白会被整段去掉，“GPL-3.0”和“协议开源”之间的空格要用 {' '} 显式写出。
// leave 为站点名称时，点击会先弹出离站确认（见 LeaveSiteDialog），并在新标签页打开
const footerLinks: { label: string; href: string; leave?: string }[] = [
  { label: t('使用文档'), href: links.docs },
  { label: t('插件市场'), href: links.pluginMarket, leave: t('麦麦插件市场') },
  { label: t('衍生项目'), href: '/projects/' },
  { label: t('关于麦麦'), href: '/about/' },
  { label: 'GitHub', href: links.repo },
];
---

<footer class="footer">
  <div class="container footer-inner">
    <nav class="footer-links" aria-label={t('页脚导航')}>
      {footerLinks.map((item) => (
        <a
          href={localPath(item.href)}
          data-leave-confirm={item.leave ? '' : undefined}
          data-leave-name={item.leave}
          target={item.leave ? '_blank' : undefined}
          rel={item.leave ? 'noopener noreferrer' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <p class="footer-copyright">
      {t('MaiSaka 以')}{' '}
      <a href={links.license} target="_blank" rel="noopener noreferrer" class="footer-link">
        GPL-3.0
      </a>
      {locale === 'en' ? '' : ' '}
      {t('协议开源；使用即表示您同意并知悉')}
      <a href={links.eula} target="_blank" rel="noopener noreferrer" class="footer-link">
        {t('「用户协议」')}
      </a>
      {t('和')}
      <a href={links.privacy} target="_blank" rel="noopener noreferrer" class="footer-link">
        {t('「隐私协议」')}
      </a>
      {t('的相关内容。')}
      <br />
      {t('AI 生成内容请仔细甄别。')}
    </p>
  </div>

  <div class="easter-egg" aria-hidden="true">
    <Image src={easterEgg} alt="" width={120} height={120} />
  </div>
  <div class="easter-bubble" aria-hidden="true">
    <span class="easter-bubble-text">{t('麦麦说得对')}</span>
  </div>
</footer>

<script>
  // 彩蛋：点击露出半截的麦麦 -> 麦麦升起（0.5s 到顶）-> 气泡从左侧滑入 -> 3.5s 时气泡滑出 -> 4s 时麦麦落回原位。
  // 动画进行中再次点击不会重复触发。
  const egg = document.querySelector<HTMLElement>('.easter-egg');
  const bubble = document.querySelector<HTMLElement>('.easter-bubble');
  if (egg && bubble) {
    let timers: ReturnType<typeof setTimeout>[] = [];

    egg.addEventListener('click', () => {
      if (egg.classList.contains('is-rising')) return;
      timers.forEach(clearTimeout);
      egg.classList.add('is-rising');
      timers = [
        setTimeout(() => bubble.classList.add('is-visible'), 500),
        setTimeout(() => bubble.classList.remove('is-visible'), 3500),
        setTimeout(() => egg.classList.remove('is-rising'), 4000),
      ];
    });
  }
</script>

<style>
  .footer {
    --egg-size: 5rem;
    --egg-hidden: 3.75rem;
    position: relative;
    min-height: 10rem;
    padding: 2.5rem 0 max(3.75rem, var(--safe-bottom));
    overflow: hidden;
    text-align: center;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.25rem;
    font-family: var(--font-display);
    font-size: var(--fs-small);
    font-weight: 700;
  }

  .footer-links a {
    color: var(--text-body);
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--c-primary);
  }

  .footer-copyright {
    max-width: 40rem;
    color: var(--text-subtle);
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 1.6;
  }

  .footer-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--c-primary-hover);
  }

  /* 彩蛋：默认只露出头顶，点击后升起 --egg-hidden 的高度 */
  .easter-egg {
    position: absolute;
    bottom: calc(var(--egg-hidden) * -1);
    left: max(15%, var(--safe-left));
    z-index: 2;
    width: var(--egg-size);
    height: var(--egg-size);
    cursor: pointer;
    transform: translateX(-50%);
    transition: filter var(--transition-fast);
  }

  .easter-egg:hover {
    filter: drop-shadow(0 0.5rem 1.5rem rgba(0, 0, 0, 0.2));
  }

  .easter-egg img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
  }

  .easter-egg.is-rising {
    pointer-events: none;
    animation: easterRise 4s ease-in-out forwards;
  }

  @keyframes easterRise {
    0%,
    100% {
      transform: translateX(-50%) translateY(0);
    }
    12.5%,
    87.5% {
      transform: translateX(-50%) translateY(calc(var(--egg-hidden) * -1));
    }
  }

  /* 气泡定位在升起后的麦麦右侧 */
  .easter-bubble {
    position: absolute;
    bottom: calc(var(--egg-size) * 0.26);
    left: calc(max(15%, var(--safe-left)) + var(--egg-size) / 2 + 0.75rem);
    z-index: 2;
    pointer-events: none;
  }

  .easter-bubble-text {
    display: inline-block;
    max-width: 10rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.75rem 0.75rem 0.75rem 0.1875rem;
    background: #eeeef0;
    color: #2b2b2b;
    font-family: var(--font-reading);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.4;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-1.875rem) scale(0.92);
    transition:
      opacity 0.24s ease-out,
      transform 0.24s ease-out;
  }

  .easter-bubble.is-visible .easter-bubble-text {
    opacity: 1;
    transform: none;
  }

  :global([data-theme='dark']) .easter-bubble-text {
    background: #3a3a3c;
    color: #f9fafc;
  }

  @media (min-width: 768px) {
    .footer {
      --egg-size: 7.5rem;
      --egg-hidden: 5.9375rem;
    }

    .easter-bubble-text {
      padding: 0.75rem 1.125rem;
      border-radius: 1.25rem 1.25rem 1.25rem 0.25rem;
      font-size: 1rem;
    }
  }
</style>
