    }
    50% {
      transform: translate(-8px, -6px);
    }
  }

  /* ===== 桌面两栏 ===== */
  /* 宽屏两栏（与 global.css 的等比缩放条件一致），尺寸取 1600×900 设计稿的值：
     演示屏 720px、文案 560px、间距 60px、每段文案高 720px（标题距段落顶 140px）、区块上下 160/80px。
     vw 上限只在根字号触到 12px 下限的窄桌面上起作用，防止横向溢出 */
  @media (min-width: 1024px) and (min-aspect-ratio: 5/4) {
    .sticky-section {
      --screen-width: min(45rem, 50vw);
      padding: 10rem 0 5rem;
    }

    /* 非当前段落变淡，脚本在场景切换时加减 is-active */
    html.js .text-block:not(.is-active) {
      opacity: 0.3;
    }

    /* 设计稿容器 1400px、左右内边距 24px，正好放下 720 + 60 + 560 的两栏 */
    .sticky-inner {
      flex-direction: row-reverse;
      align-items: flex-start;
      justify-content: center;
      gap: 3.75rem;
      max-width: 87.5rem;
      padding-right: max(1.5rem, var(--safe-right));
      padding-left: max(1.5rem, var(--safe-left));
    }

    .sticky-items {
      width: min(35rem, 38vw);
    }

    /* 设计稿：每段高 720px（最后一段 680px），标题统一落在段落顶部往下 140px 处 */
    .text-block,
    .text-block + .text-block {
      min-height: 45rem;
      padding-top: 8.75rem;
    }

    .text-block + .text-block:last-child {
      min-height: 42.5rem;
    }

    .text-block-title {
      font-size: 2.5rem;
    }

    .text-block-subtitle {
      margin-bottom: 1.75rem;
      font-size: 2rem;
    }

    .text-block-desc {
      font-size: 1.25rem;
    }

    /* 演示屏高度是宽度的 2/3，所以 top = 视口一半 - 宽度的 1/3 即可垂直居中，且不压到导航栏 */
    .sticky-screen-wrap {
      display: block;
      top: max(var(--nav-offset), calc(50svh - var(--screen-width) / 3));
      margin-top: 8.75rem;
    }
  }
</style>

<script>
  // 特性区场景切换：
  // 1. 区块第一次进入视口 -> 激活聊天场景并播放气泡入场动画；
  // 2. 某段文案越过视口中线 -> 演示屏切到对应场景（换底色、淡入场景、播放该场景的入场动画），其余文案变淡；
  //    单栏布局下演示屏和变淡效果都由 CSS 关掉，脚本照常运行但没有可见影响。
  // 3. 演示屏外框尺寸变化 -> 重新计算 720×480 画布的缩放比例。
  const section = document.querySelector<HTMLElement>('.sticky-section');
  const screen = section?.querySelector<HTMLElement>('.sticky-screen');
  const wrap = section?.querySelector<HTMLElement>('.sticky-screen-wrap');

  if (section && screen && wrap) {
    const blocks = section.querySelectorAll<HTMLElement>('.text-block');
    const scenes = section.querySelectorAll<HTMLElement>('.screen-scene');
    const bgColors: Record<string, string> = {
      chat: 'rgb(219, 131, 36)',
      config: '#80de41',
      plugins: '#30ccef',
    };
    const ease = 'cubic-bezier(0.22, 0.61, 0.36, 1)';
    let active = '';

    // 先瞬间把元素放回起始位置，强制回流后再设置过渡和终点，保证每次切回来都能重新播放动画
    function replay(element: HTMLElement | null, from: string, transition: string) {
      if (!element) return;
      element.style.transition = 'none';
      element.style.opacity = '0';
      element.style.transform = from;
      void element.offsetHeight;
      element.style.transition = transition;
      element.style.opacity = '1';
      element.style.transform = 'none';
    }

    // 聊天场景：三条气泡每隔 0.6s 依次从两侧滑入
    function playChat() {
      section!.querySelectorAll<HTMLElement>('.screen-chat .chat-bubble').forEach((bubble, index) => {
        bubble.style.opacity = '0';
        bubble.style.transform = bubble.classList.contains('user')
          ? 'translateX(30px) scale(0.92)'
          : 'translateX(-30px) scale(0.92)';
        setTimeout(
          () => {
            bubble.style.opacity = '1';
            bubble.style.transform = 'none';
          },
          600 + index * 600
        );
      });
    }

    // 配置场景：左侧编辑器先从左下滑入，0.5s 后右侧 WebUI 从右下滑入
    function playConfig() {
      replay(
        section!.querySelector<HTMLElement>('.config-editor'),
        'translate(-120px, 480px)',
        `opacity 0.55s ease-out, transform 0.65s ${ease}`
      );
      replay(
        section!.querySelector<HTMLElement>('.config-webui'),
        'translate(120px, 480px)',
        `opacity 0.55s 0.5s ease-out, transform 0.65s 0.5s ${ease}`
      );
    }

    // 插件场景：插件面板从右上角滑入，0.9s 后鼠标指针出现
    function playPlugins() {
      const scroll = section!.querySelector<HTMLElement>('.plugin-scroll');
      if (scroll) {
        scroll.style.opacity = '1';
        scroll.style.transform = 'none';
      }
      replay(
        section!.querySelector<HTMLElement>('.plugin-panel'),
        'translate(120px, -480px)',
        `opacity 0.55s ease-out, transform 0.85s ${ease}`
      );
      replay(
        section!.querySelector<HTMLElement>('.plugin-cursor'),
        'translate(40px, -30px)',
        `opacity 0.4s 0.9s ease-out, transform 0.5s 0.9s ${ease}`
      );
    }

    const players: Record<string, () => void> = { chat: playChat, config: playConfig, plugins: playPlugins };

    function activate(target: string) {
      if (target === active) return;
      active = target;
      screen!.style.background = bgColors[target] || bgColors.chat;
      scenes.forEach((scene) => {
        scene.style.opacity = scene.dataset.scene === target ? '1' : '0';
      });
      blocks.forEach((block) => block.classList.toggle('is-active', block.dataset.mockup === target));
      players[target]?.();
    }

    // 区块进入视口时先激活聊天场景（顺带播放气泡动画），之后交给中线观察器切换
    const enterObserver = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          activate('chat');
          enterObserver.disconnect();
        }
      },
      { threshold: 0.1 }
    );
    enterObserver.observe(section);

    // rootMargin 把观察区域压成视口正中间的一条线，哪段文案压在线上就切到哪个场景（只在桌面两栏下有可见效果）
    const centerObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) activate((entry.target as HTMLElement).dataset.mockup || 'chat');
        });
      },
      { rootMargin: '-50% 0px -50% 0px' }
    );
    blocks.forEach((block) => centerObserver.observe(block));
    blocks[0]?.classList.add('is-active');

    // 单栏时演示屏隐藏、宽度为 0，跳过计算，等切回两栏时 ResizeObserver 会再次触发
    const updateScale = () => {
      if (wrap.clientWidth > 0) wrap.style.setProperty('--mockup-scale', String(wrap.clientWidth / 720));
    };
    new ResizeObserver(updateScale).observe(wrap);
    updateScale();
  }
</script>
