---
import { Image } from 'astro:assets';
import amaidesuBg from '../assets/amaidesu.png';
import mofoxBg from '../assets/mofox.jpg';
import maicraftBg from '../assets/maicraft.png';
import pluginBg from '../assets/plugin.png';

const featuredProjects = [
  {
    name: 'Amaidesu',
    description: '让麦麦在 B 站开播。',
    tone: 'market',
    href: 'https://github.com/Mai-with-u/Amaidesu',
    bg: amaidesuBg,
    large: true,
  },
  {
    name: 'MoFox_Bot',
    description: '基于 MaiCore 0.10.0 的增强型 Fork，更稳定更有趣。',
    tone: 'web',
    href: 'https://github.com/MoFox-Studio/MoFox_Bot',
    bg: mofoxBg,
  },
  {
    name: 'MaiCraft',
    description: '让麦麦陪你玩 Minecraft（暂时停止维护中）。',
    tone: 'mobile',
    href: 'https://github.com/Mai-with-u/MaiCraft',
    bg: maicraftBg,
  },
];

const compactProjects = [
  {
    name: 'MaiBot 文档站',
    description: '开发者文档与使用指南。',
    color: 'var(--c-primary)',
    href: 'https://docs.mai-mai.org/',
  },
  {
    name: 'MaiBot Android',
    description: '让麦麦运行在你的安卓设备上，无需服务器',
    color: 'var(--c-green)',
    href: 'https://github.com/LittleSadSheep/MaiDroid',
  },
  {
    name: 'MaiWeb',
    description: '麦麦官网（？',
    color: '#007aff',
    href: 'https://github.com/Mai-with-u/MaiWeb',
  },
];

const actionCards = [
  {
    name: '开发文档',
    description: '想对 MaiBot 做出贡献？不妨先看看开发文档',
    href: 'https://docs.mai-mai.org/develop/',
    variant: 'primary',
    action: '立即查看',
  },
  {
    name: '交流社区',
    description: '找到志同道合的伙伴',
    href: 'https://docs.mai-mai.org/community/#qq-%E4%BA%A4%E6%B5%81%E7%BE%A4',
    variant: 'outline',
    action: '加入我们',
  },
];

const fallbackContributors = [
  { login: 'LittleSkinChina', avatar_url: 'https://github.com/LittleSkinChina.png' },
  { login: 'Mai-with-u', avatar_url: 'https://github.com/Mai-with-u.png' },
  { login: 'github', avatar_url: 'https://github.com/github.png' },
  { login: 'dependabot', avatar_url: 'https://github.com/dependabot.png' },
  { login: 'actions-user', avatar_url: 'https://github.com/actions-user.png' },
  { login: 'octocat', avatar_url: 'https://github.com/octocat.png' },
];

interface Contributor {
  login: string;
  avatar_url: string;
}

async function getMaiBotContributors(): Promise<Contributor[]> {
  try {
    const response = await fetch('https://api.github.com/repos/Mai-with-u/MaiBot/contributors?per_page=60', {
      headers: {
        Accept: 'application/vnd.github+json',
        'User-Agent': 'MaiWeb',
      },
    });

    if (!response.ok) return fallbackContributors;

    const data = (await response.json()) as Contributor[];
    const contributors = data
      .filter((contributor) => contributor.login && contributor.avatar_url)
      .map(({ login, avatar_url }) => ({ login, avatar_url }));

    return contributors.length >= 12 ? contributors : fallbackContributors;
  } catch {
    return fallbackContributors;
  }
}

const contributors = await getMaiBotContributors();
const avatarRows = Array.from({ length: 6 }, (_, rowIndex) => {
  const offset = rowIndex * 7;
  const row = Array.from({ length: 14 }, (_, itemIndex) => contributors[(offset + itemIndex) % contributors.length]);

  return {
    direction: rowIndex % 2 === 0 ? 'left' : 'right',
    duration: 34 + rowIndex * 5,
    avatars: [...row, ...row],
  };
});
---

<main class="projects-page">
  <div class="projects-container">
    <header class="sub-page-header reveal">
      <nav class="breadcrumb" aria-label="面包屑导航">
        <a href="/">首页</a>
        <span aria-hidden="true">&gt;</span>
        <span>衍生项目</span>
      </nav>
      <div class="title-block">
        <p class="eyebrow">Derivative Projects</p>
        <h1>衍生项目</h1>
      </div>
      <p class="header-desc">官方与社区共同打造的精彩应用，让你的 MaiSaka 体验更加丰富</p>
    </header>

    <section class="chapter project-chapter reveal reveal-delay-1" aria-labelledby="projects-heading">
      <h2 id="projects-heading" class="visually-hidden">衍生项目列表</h2>
      <div class="featured-grid">
        <a
          class="project-card project-card-large tone-market"
          href={featuredProjects[0].href}
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="texture-bg texture-bg-amaidesu">
            <Image src={featuredProjects[0].bg} alt="" loading="lazy" decoding="async" class="card-bg-image" />
          </div>
          <div class="texture-blur texture-blur-amaidesu" aria-hidden="true"></div>
          <div class="card-content">
            <h3>{featuredProjects[0].name}</h3>
            <p>{featuredProjects[0].description}</p>
          </div>
          <div class="card-orbit" aria-hidden="true"></div>
          <span class="card-link" aria-hidden="true">了解项目 <span>→</span></span>
        </a>

        <div class="right-stack">
          {
            featuredProjects.slice(1).map((project) => (
              <a
                class={`project-card project-card-small tone-${project.tone}`}
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <div class="texture-bg">
                  <Image src={project.bg} alt="" loading="lazy" decoding="async" class="card-bg-image" />
                </div>
                <div class="texture-blur texture-blur-small" aria-hidden="true" />
                <div class="card-content">
                  <h3>{project.name}</h3>
                  <p>{project.description}</p>
                </div>
                <span class="card-link" aria-hidden="true">
                  了解项目 <span>→</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="compact-row">
        {
          compactProjects.map((project) => (
            <a
              class="compact-card"
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              style={`--compact-bg: ${project.color}`}
            >
              <span class="compact-marker" aria-hidden="true" />
              <span class="compact-copy">
                <strong>{project.name}</strong>
                <span>{project.description}</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="chapter market-spotlight reveal reveal-delay-2" aria-labelledby="market-heading">
      <div class="texture-bg texture-bg-market">
        <Image src={pluginBg} alt="" loading="lazy" decoding="async" class="market-bg-image" />
      </div>
      <div class="texture-blur texture-blur-market" aria-hidden="true"></div>
      <div class="market-copy">
        <span class="spotlight-label">插件市场</span>
        <h2 id="market-heading">让 MaiBot 无限延伸</h2>
        <p>
          来自社区开发者的 500+ 个插件，覆盖天气、音乐、AI绘图、群管理等几乎所有场景。每一个插件，都是某位开发者对
          MaiBot 的一次扩充。
        </p>
      </div>
      <a class="spotlight-link" href="https://docs.mai-mai.org/" target="_blank" rel="noopener noreferrer">
        探索插件市场
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <path
            d="M4 10h10.2m-4.4-4.4L14.2 10l-4.4 4.4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </section>

    <section class="chapter manifesto-section reveal reveal-delay-3" aria-labelledby="manifesto-heading">
      <div class="manifesto-intro">
        <h2 id="manifesto-heading">
          <span>你的每一行代码</span>
          <span>都是 MaiBot 的一部分</span>
        </h2>
        <p>你的每一个 issue，每一个 PR，每一个插件，都在推动着 MaiBot 的成长</p>
      </div>

      <div class="manifesto-grid">
        <article class="quote-card">
          <div class="contributors-bg" aria-hidden="true">
            {
              avatarRows.map((row) => (
                <div
                  class={`contributors-row ${row.direction === 'right' ? 'is-reverse' : ''}`}
                  style={`--marquee-duration: ${row.duration}s`}
                >
                  <div class="contributors-track">
                    {row.avatars.map((contributor) => (
                      <img
                        src={contributor.avatar_url}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class="contributor-avatar"
                      />
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
          <div class="quote-mark" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 56 56" fill="none">
              <path
                d="M34.0335 8.36683C34.9087 7.49167 36.0957 7 37.3333 7H44.3333C45.571 7 46.758 7.49167 47.6332 8.36683C48.5083 9.242 49 10.429 49 11.6667V35C49 38.713 47.525 42.274 44.8995 44.8995C42.274 47.525 38.713 49 35 49C34.3812 49 33.7877 48.7542 33.3501 48.3166C32.9125 47.879 32.6667 47.2855 32.6667 46.6667V42C32.6667 41.3812 32.9125 40.7877 33.3501 40.3501C33.7877 39.9125 34.3812 39.6667 35 39.6667C36.2377 39.6667 37.4247 39.175 38.2998 38.2998C39.175 37.4247 39.6667 36.2377 39.6667 35V32.6667C39.6667 32.0478 39.4208 31.4543 38.9832 31.0168C38.5457 30.5792 37.9522 30.3333 37.3333 30.3333C36.0957 30.3333 34.9087 29.8417 34.0335 28.9665C33.1583 28.0913 32.6667 26.9043 32.6667 25.6667V11.6667C32.6667 10.429 33.1583 9.242 34.0335 8.36683Z"
                stroke="#F5841F"
                stroke-width="2"
                stroke-linecap="round"></path>
              <path
                d="M8.36683 8.36683C9.242 7.49167 10.429 7 11.6667 7H18.6667C19.9043 7 21.0913 7.49167 21.9665 8.36683C22.8417 9.242 23.3333 10.429 23.3333 11.6667V35C23.3333 38.713 21.8583 42.274 19.2328 44.8995C16.6073 47.525 13.0464 49 9.33333 49C8.71449 49 8.121 48.7542 7.68342 48.3166C7.24583 47.879 7 47.2855 7 46.6667V42C7 41.3812 7.24583 40.7877 7.68342 40.3501C8.121 39.9125 8.71449 39.6667 9.33333 39.6667C10.571 39.6667 11.758 39.175 12.6332 38.2998C13.5083 37.4247 14 36.2377 14 35V32.6667C14 32.0478 13.7542 31.4543 13.3166 31.0168C12.879 30.5792 12.2855 30.3333 11.6667 30.3333C10.429 30.3333 9.242 29.8417 8.36683 28.9665C7.49167 28.0913 7 26.9043 7 25.6667V11.6667C7 10.429 7.49167 9.242 8.36683 8.36683Z"
                stroke="#F5841F"
                stroke-width="2"
                stroke-linecap="round"></path>
            </svg>
          </div>
          <p class="quote-text">
            截至今日，MaiBot 社区产出了 <strong>6K+ 次提交</strong>，关闭了 <strong>760+ 个 issue</strong>，来自 <strong
              >110+ 位贡献者</strong
            > 的共同努力。
          </p>
          <p class="quote-subtext">MaiBot 的每一次迭代，背后都是无数个深夜的 PR 和清晨的 code review。</p>
        </article>

        <div class="action-stack">
          {
            actionCards.map((card) => (
              <a
                class={`action-card action-${card.variant}`}
                href={card.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="action-copy">
                  <strong>{card.name}</strong>
                  <span>{card.description}</span>
                </span>
                <span class="action-button">
                  {card.action}
                  <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true">
                    <path
                      d="M3.5 9h8.8M8.5 5.2 12.3 9l-3.8 3.8"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</main>

<style>
  .projects-page {
    position: relative;
    padding: 95px 0 120px;
    overflow: hidden;
  }

  .projects-container {
    width: 100%;
    max-width: 1448px;
    margin: 0 auto;
    padding: 0 clamp(20px, 6vw, 52px);
  }

  .sub-page-header {
    display: flex;
    min-height: 220px;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 40px 0 36px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    color: #a2abbc;
  }

  .breadcrumb a {
    transition: color var(--transition-fast);
  }

  .breadcrumb a:hover,
  .breadcrumb span[aria-hidden='true'] {
    color: var(--c-primary);
  }

  .title-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.42px;
    line-height: 1.2;
    color: var(--c-primary);
  }

  .title-block h1 {
    font-size: clamp(40px, 5vw, 48px);
    line-height: 1.1;
    color: #121938;
  }

  .header-desc {
    max-width: 620px;
    font-size: 16px;
    line-height: 1.6;
    color: rgba(38, 49, 65, 0.5);
  }

  .chapter {
    position: relative;
  }

  .project-chapter {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-bottom: 72px;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: minmax(0, 720px) minmax(320px, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  .right-stack {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 24px;
  }

  .project-card,
  .compact-card,
  .market-spotlight,
  .quote-card,
  .action-card {
    box-shadow: 0 18px 48px rgba(24, 65, 134, 0.08);
  }

  .project-card {
    position: relative;
    display: flex;
    overflow: hidden;
    flex-direction: column;
    justify-content: space-between;
    min-height: 215px;
    padding: 24px;
    border-radius: 24px;
    color: #fff;
    isolation: isolate;
  }

  .project-card::before,
  .project-card::after {
    position: absolute;
    z-index: -1;
    content: '';
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.09);
    transition: opacity 0.6s ease;
  }

  .project-card::before {
    right: -72px;
    bottom: -90px;
    width: 240px;
    height: 240px;
  }

  .project-card::after {
    right: 86px;
    bottom: 58px;
    width: 68px;
    height: 68px;
    opacity: 0.75;
  }

  .project-card:hover,
  .compact-card:hover,
  .action-card:hover,
  .spotlight-link:hover {
    transform: translateY(-3px);
  }

  .project-card-large {
    min-height: 454px;
  }

  .tone-market {
    background: linear-gradient(135deg, #1b3a2a 0%, #10271e 100%);
  }

  .tone-market::after {
    position: absolute;
    inset: 0;
    z-index: 0;
    content: '';
    background: radial-gradient(ellipse 55% 50% at 18% 22%, rgba(16, 39, 30, 0.2) 0%, transparent 55%);
    pointer-events: none;
  }

  .tone-web {
    background: linear-gradient(135deg, #0f1b35 0%, #070f22 100%);
  }

  .tone-web::after {
    position: absolute;
    inset: 0;
    z-index: 0;
    content: '';
    background: linear-gradient(90deg, rgba(15, 27, 53, 0.45) 0%, rgba(15, 27, 53, 0.12) 48%, transparent 100%);
    pointer-events: none;
  }

  .tone-mobile {
    background: linear-gradient(135deg, #3d2800 0%, #241700 100%);
  }

  .tone-mobile::after {
    position: absolute;
    inset: 0;
    z-index: 0;
    content: '';
    background: linear-gradient(90deg, rgba(61, 40, 0, 0.45) 0%, rgba(61, 40, 0, 0.12) 48%, transparent 100%);
    pointer-events: none;
  }

  .texture-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  .texture-bg-amaidesu .card-bg-image,
  .texture-bg-market .market-bg-image,
  .texture-bg .card-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.22;
    transform: scale(1.05);
  }

  .texture-bg-amaidesu .card-bg-image {
    opacity: 0.8;
  }

  .texture-blur {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    backdrop-filter: blur(18px) saturate(1.1);
    pointer-events: none;
  }

  .texture-blur-amaidesu {
    background: radial-gradient(ellipse 50% 45% at 16% 20%, rgba(16, 39, 30, 0.22) 0%, transparent 52%);
    mask-image: radial-gradient(ellipse 50% 45% at 16% 20%, rgba(0, 0, 0, 0.75) 0%, transparent 52%);
    -webkit-mask-image: radial-gradient(ellipse 50% 45% at 16% 20%, rgba(0, 0, 0, 0.75) 0%, transparent 52%);
  }

  .texture-bg .card-bg-image {
    opacity: 0.8;
  }

  .texture-bg-market .market-bg-image {
    opacity: 0.22;
  }

  .texture-blur-small {
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.38) 0%, rgba(0, 0, 0, 0.1) 40%, transparent 66%);
    mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.3) 40%, transparent 66%);
    -webkit-mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.3) 40%, transparent 66%);
  }

  .tone-market .card-content,
  .tone-market .card-link,
  .tone-web .card-content,
  .tone-web .card-link,
  .tone-mobile .card-content,
  .tone-mobile .card-link {
    position: relative;
    z-index: 1;
  }

  .card-content {
    display: flex;
    max-width: 460px;
    flex-direction: column;
    gap: 10px;
  }

  .card-content h3 {
    font-size: clamp(22px, 3vw, 28px);
    line-height: 1;
  }

  .project-card-small .card-content h3 {
    font-size: 22px;
  }

  .card-content p {
    font-family: 'HarmonyOS Sans SC', 'PingFang SC', 'Microsoft YaHei', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start;
    font-family: 'HarmonyOS Sans SC', 'PingFang SC', 'Microsoft YaHei', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.86);
    opacity: 0;
    transform: translateY(8px);
    transition: all var(--transition-fast);
  }

  .project-card:hover .card-link {
    opacity: 1;
    transform: none;
  }

  .card-orbit {
    position: absolute;
    right: 74px;
    bottom: 72px;
    width: 180px;
    height: 180px;
    border: 1px solid rgba(128, 222, 65, 0.22);
    border-radius: 40px;
    transform: rotate(18deg);
    transition: opacity 0.6s ease;
  }

  .tone-market.is-loaded .card-orbit,
  .tone-market.is-loaded.project-card::before,
  .tone-market.is-loaded.project-card::after,
  .tone-web.is-loaded .card-orbit,
  .tone-web.is-loaded.project-card::before,
  .tone-web.is-loaded.project-card::after,
  .tone-mobile.is-loaded .card-orbit,
  .tone-mobile.is-loaded.project-card::before,
  .tone-mobile.is-loaded.project-card::after {
    opacity: 0;
  }

  .compact-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .compact-card {
    display: flex;
    min-height: 96px;
    align-items: center;
    gap: 16px;
    padding: 20px;
    border: 1px solid rgba(229, 231, 235, 0.9);
    border-radius: 16px;
    background: var(--compact-bg);
    color: #fff;
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .compact-marker {
    width: 6px;
    align-self: stretch;
    flex: 0 0 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.8);
  }

  .compact-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 6px;
  }

  .compact-copy strong {
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 1.2;
  }

  .compact-copy span {
    font-size: 13px;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.84);
  }

  .market-spotlight {
    display: flex;
    position: relative;
    min-height: 540px;
    overflow: hidden;
    isolation: isolate;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
    padding: 24px;
    border-radius: 24px;
    background: linear-gradient(135deg, #0d2b26 0%, #061a16 100%);
    color: #fff;
  }

  .market-spotlight::after {
    position: absolute;
    inset: 0;
    z-index: 0;
    content: '';
    background: linear-gradient(90deg, rgba(6, 26, 22, 0.65) 0%, rgba(6, 26, 22, 0.28) 45%, transparent 100%);
    pointer-events: none;
  }

  .texture-blur-market {
    background: linear-gradient(90deg, rgba(6, 26, 22, 0.78) 0%, rgba(6, 26, 22, 0.32) 42%, transparent 72%);
