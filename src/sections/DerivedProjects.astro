<script>
  function markCardLoaded(card: Element) {
    if (card) card.classList.add('is-loaded');
  }

  document.querySelectorAll('.project-card').forEach((card) => {
    const img = card.querySelector('.texture-bg .card-bg-image');
    if (!img) return;

    if ((img as HTMLImageElement).complete) {
      markCardLoaded(card);
    } else {
      img.addEventListener('load', () => markCardLoaded(card), { once: true });
      img.addEventListener('error', () => markCardLoaded(card), { once: true });
    }
  });
</script>
