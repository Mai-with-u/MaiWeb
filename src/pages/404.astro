---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Navbar from '../sections/Navbar.astro';
import Footer from '../sections/Footer.astro';
import { links } from '../data/links';
import notFoundMai from '../assets/404-mai.png';

// Astro 7 起模板按 JSX 规则处理空白：标题里“404”和后半句分在两行写，中间的空格要用 {' '} 显式写出，否则会连在一起。
---

<Layout
  title="404 - 页面未找到 | MaiBot"
  description="抱歉，您访问的页面不存在或已被移动。"
  canonicalPath="/404"
  noindex
>
  <Navbar />
  <main class="not-found-page">
    <!-- Large outline "404" in background -->
    <svg class="not-found-bg-text" viewBox="0 0 1000 420" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
      <text
        x="50%"
        y="340"
        text-anchor="middle"
        font-family="var(--font-display)"
        font-size="400"
        font-weight="800"
        fill="none"
        stroke="currentColor"
        stroke-width="2">404</text
      >
    </svg>

    <!-- Decorative orange squares -->
    <div class="deco-square square-1" aria-hidden="true"></div>
    <div class="deco-square square-2" aria-hidden="true"></div>
    <div class="deco-square square-3" aria-hidden="true"></div>
    <div class="deco-square square-4" aria-hidden="true"></div>
    <div class="deco-square square-5" aria-hidden="true"></div>

    <!-- Decorative question mark circles -->
    <svg class="deco-question question-1" viewBox="0 0 40 40" aria-hidden="true">
      <circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
      <text x="20" y="27" text-anchor="middle" font-size="18" font-weight="600" fill="currentColor">?</text>
    </svg>
    <svg class="deco-question question-2" viewBox="0 0 40 40" aria-hidden="true">
      <circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
      <text x="20" y="27" text-anchor="middle" font-size="18" font-weight="600" fill="currentColor">?</text>
    </svg>
    <svg class="deco-question question-3" viewBox="0 0 40 40" aria-hidden="true">
      <circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
      <text x="20" y="27" text-anchor="middle" font-size="18" font-weight="600" fill="currentColor">?</text>
    </svg>

    <div class="not-found-content">
      <div class="not-found-illustration">
        <Image src={notFoundMai} alt="麦麦正在吃文件" width={400} height={540} loading="eager" decoding="async" />
      </div>

      <div class="not-found-text">
        <h1 class="not-found-title">
          <span class="title-highlight">404</span>{' '}
          <span>你似乎来到了火星……</span>
        </h1>
        <p class="not-found-subtitle">文件可能被麦麦当成小零食吃掉了……（悲</p>
      </div>

      <div class="not-found-actions">
        <a href="/" class="not-found-btn not-found-btn-primary">
          <svg class="btn-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"></path>
          </svg>
          回到首页
        </a>
        <a
          href={links.siteIssues}
          target="_blank"
          rel="noopener noreferrer"
          class="not-found-btn not-found-btn-outline"
        >
          <svg
            class="btn-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          报告问题
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .not-found-page {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(var(--nav-offset) + 1rem) max(var(--page-gutter), var(--safe-right)) max(4rem, var(--safe-bottom))
      max(var(--page-gutter), var(--safe-left));
    overflow: hidden;
  }

  /* Background outline "404" */
  .not-found-bg-text {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(100vw, 100rem);
    height: auto;
    transform: translate(-50%, -50%);
    color: rgba(0, 0, 0, 0.05);
    pointer-events: none;
    z-index: 0;
  }

  /* Decorative squares */
  .deco-square {
    position: absolute;
    border-radius: 0.3rem;
    background: var(--c-primary);
    pointer-events: none;
    z-index: 0;
  }

  .square-1 {
    left: 10%;
    top: 9.375rem;
    width: 1.5rem;
    height: 1.5rem;
    opacity: 0.6;
    transform: rotate(15deg);
  }

  .square-2 {
    right: 8%;
    top: 12.25rem;
    width: 1.125rem;
    height: 1.125rem;
    opacity: 0.4;
    transform: rotate(-10deg);
  }

  .square-3 {
    right: 6%;
    top: 40.625rem;
    width: 2rem;
    height: 2rem;
    opacity: 0.8;
    transform: rotate(45deg);
  }

  .square-4 {
    left: 15%;
    top: 43.125rem;
    width: 1.25rem;
    height: 1.25rem;
    opacity: 0.5;
    transform: rotate(-30deg);
  }

  .square-5 {
    right: 20%;
    top: 6.25rem;
    width: 0.75rem;
    height: 0.75rem;
    opacity: 0.3;
    transform: rotate(10deg);
  }

  /* Decorative question marks */
  .deco-question {
    position: absolute;
    width: 3rem;
    height: 3rem;
    color: rgba(var(--c-primary-rgb), 0.45);
    pointer-events: none;
    z-index: 0;
  }

  .question-1 {
    left: 20%;
    top: 14.75rem;
    transform: rotate(-12deg);
  }

  .question-2 {
    right: 18%;
    top: 18.75rem;
    transform: rotate(15deg);
  }

  .question-3 {
    left: 26%;
    top: 37.5rem;
    width: 2.5rem;
    height: 2.5rem;
    transform: rotate(20deg);
  }

  /* Content */
  .not-found-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    width: 100%;
    max-width: 50rem;
    text-align: center;
    animation: fadeInUp 0.72s ease-out forwards;
  }

  .not-found-illustration {
    width: 100%;
    max-width: 26.25rem;
    aspect-ratio: 420 / 420;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .not-found-illustration img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .not-found-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  .not-found-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--text-strong);
  }

  .title-highlight {
    color: var(--c-primary);
  }

  .not-found-subtitle {
    font-size: clamp(1rem, 2.4vw, 1.25rem);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
  }

  .not-found-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 8.75rem;
    padding: 0.75rem 1.125rem;
    border-radius: 1rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn-icon {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
  }

  .not-found-btn-primary {
    background: var(--c-primary);
    color: #fff;
    box-shadow: 0 0.5rem 1.75rem rgba(var(--c-primary-rgb), 0.32);
  }

  .not-found-btn-primary:hover {
    background: var(--c-primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 0.75rem 2.25rem rgba(var(--c-primary-rgb), 0.4);
  }

  .not-found-btn-outline {
    background: transparent;
    color: var(--text-strong);
    border: 1.5px solid currentColor;
  }

  .not-found-btn-outline:hover {
    background: rgba(26, 26, 46, 0.06);
    transform: translateY(-2px);
  }

  /* Dark mode */
  :global([data-theme='dark']) .not-found-bg-text {
    color: rgba(255, 255, 255, 0.06);
  }

  :global([data-theme='dark']) .not-found-btn-outline:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  :global([data-theme='dark']) .deco-question {
    color: rgba(var(--c-primary-rgb), 0.35);
  }

  /* 触屏设备保证按钮点击高度 */
  @media (pointer: coarse) {
    .not-found-btn {
      min-height: 44px;
    }
  }

  /* 窄屏：装饰元素会压到插画和文字上，直接隐藏；两个按钮改为纵向铺满 */
  @media (max-width: 767.98px) {
    .deco-square,
    .deco-question {
      display: none;
    }

    .not-found-actions {
      flex-direction: column;
      width: 100%;
    }

    .not-found-btn {
      width: 100%;
    }
  }
</style>
