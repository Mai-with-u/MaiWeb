---
export interface Props {
  variant?: 'primary' | 'green';
  size?: 'large' | 'small';
  href?: string;
  icon?: 'download' | 'paperplane' | 'docs' | 'qq' | 'github' | 'none';
  label: string;
  sublabel?: string;
}

const { variant = 'primary', size = 'large', href = '#', icon = 'download', label, sublabel } = Astro.props;
---

<span class:list={['cta-btn-wrap', `cta-btn-wrap-${variant}`, `cta-btn-wrap-${size}`]}>
  <span class:list={['cta-btn-clip', `cta-btn-clip-${variant}`]}>
    <a href={href} class:list={['cta-btn', `cta-btn-${variant}`, `cta-btn-${size}`]}>
      <span class="cta-btn-icon">
        {icon === 'download' && (
          <svg viewBox="0 0 24 24" width="100%" height="100%" fill="currentColor">
            <path d="M12 16l-5-5h3V4h4v7h3l-5 5zm-7 2v2h14v-2H5z" />
          </svg>
        )}
        {icon === 'paperplane' && (
          <svg viewBox="0 0 24 24" width="100%" height="100%" fill="currentColor">
            <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2 .01 7z" />
          </svg>
        )}
        {icon === 'docs' && (
          <svg viewBox="0 0 24 24" width="100%" height="100%" fill="currentColor">
            <path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" />
          </svg>
        )}
        {icon === 'qq' && (
          <svg viewBox="0 0 24 24" width="100%" height="100%" fill="currentColor">
            <path d="M12.003 2c-2.265 0-6.29 1.364-6.29 7.325v1.195S3.55 14.96 3.55 17.474c0 .665.17 1.025.28 1.025.114 0 .902-.484 1.748-2.072 0 0-.18 2.197 1.904 3.967 0 0-1.77.495-1.77 1.182 0 .686 4.078.43 6.29.43 2.21 0 6.29.256 6.29-.43 0-.687-1.77-1.182-1.77-1.182 2.085-1.77 1.904-3.967 1.904-3.967.846 1.588 1.634 2.072 1.748 2.072.11 0 .28-.36.28-1.025 0-2.514-2.164-6.954-2.164-6.954V9.325C18.29 3.364 14.268 2 12.003 2z" />
          </svg>
        )}
        {icon === 'github' && (
          <svg viewBox="0 0 24 24" width="100%" height="100%" fill="currentColor">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      )}
      {icon === 'none' && (
        <svg viewBox="0 0 24 24" width="100%" height="100%" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" />
        </svg>
      )}
    </span>
    <span class="cta-btn-text">
      <span class="cta-btn-label">{label}</span>
      {sublabel && <span class="cta-btn-sublabel">{sublabel}</span>}
    </span>
  </a>
</span>
</span>

<style>
  /* ===== Layer 0: shadow only (no clip-path) ===== */
  .cta-btn-wrap {
    display: inline-flex;
    flex-shrink: 0;
    transition: filter var(--transition-fast);
  }

  .cta-btn-wrap-primary {
    filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.2));
  }

  .cta-btn-wrap-primary:hover {
    filter: drop-shadow(0 6px 24px rgba(0, 0, 0, 0.3));
  }

  .cta-btn-wrap-green {
    filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.2));
  }

  .cta-btn-wrap-green:hover {
    filter: drop-shadow(0 6px 24px rgba(0, 0, 0, 0.3));
  }

  /* ===== Layer 1: clip-path only (cut corner) ===== */
  .cta-btn-clip-primary {
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%);
  }

  .cta-btn-clip-green {
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%);
  }

  /* ===== Layer 2: background + layout (no clip-path, no filter) ===== */
  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    color: #fff;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .cta-btn-primary {
    background: #e97f0f;
  }

  .cta-btn-wrap-primary:hover .cta-btn-primary {
    background: #d06d0a;
    transform: translateY(-2px);
  }

  .cta-btn-green {
    background: #80de41;
  }

  .cta-btn-wrap-green:hover .cta-btn-green {
    background: #6fd132;
    transform: translateY(-2px);
  }

  /* === Sizing === */
  .cta-btn-large {
    padding: 14px 20px 14px 18px;
    min-width: 194px;
    min-height: 71px;
  }

  .cta-btn-small {
    padding: 10px 14px 10px 12px;
    min-width: 123px;
    min-height: 45px;
  }

  .cta-btn-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cta-btn-wrap-large .cta-btn-icon {
    width: 28px;
    height: 28px;
  }

  .cta-btn-wrap-small .cta-btn-icon {
    width: 20px;
    height: 20px;
  }

  .cta-btn-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .cta-btn-label {
    font-size: 16px;
    letter-spacing: 0.48px;
  }

  .cta-btn-wrap-large .cta-btn-label {
    font-size: 24px;
  }

  .cta-btn-sublabel {
    font-size: 12px;
    opacity: 0.9;
    letter-spacing: 0.36px;
  }

  .cta-btn-wrap-large .cta-btn-sublabel {
    font-size: 16px;
  }

  .cta-btn-wrap-small .cta-btn-label {
    font-size: 16px;
  }
</style>
