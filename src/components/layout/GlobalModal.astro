  }

  @media (max-width: 760px) {
    .modal-card--qq {
      padding: 28px 22px;
      max-height: 86vh;
      max-height: min(86vh, calc(100dvh - max(24px, var(--safe-top)) - max(24px, var(--safe-bottom))));
    }

