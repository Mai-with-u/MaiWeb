      radial-gradient(circle at 100% 0%, rgba(var(--qq-accent-rgb), 0.18), transparent 38%),
      linear-gradient(135deg, rgba(var(--qq-accent-rgb), 0.1), rgba(var(--qq-accent-rgb), 0.02) 45%, #ffffff 100%);
  }

  .qq-card::before {
    content: '';
    position: absolute;
    top: -58px;
    left: -34px;
    width: 210px;
    height: 124px;
    border-radius: 999px;
    border: 1px solid rgba(var(--qq-accent-rgb), 0.14);
    background: rgba(var(--qq-accent-rgb), 0.06);
    transform: rotate(-12deg);
  }

  .qq-card::after {
    content: '';
    position: absolute;
    right: -42px;
    bottom: -54px;
    width: 132px;
    height: 132px;
    border-radius: 36px;
    background: rgba(var(--qq-accent-rgb), 0.08);
    transform: rotate(18deg);
  }

  .qq-card__body,
  .qq-card__button {
    position: relative;
    z-index: 1;
  }

  .qq-card__body {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 6px;
  }

  .qq-card__title-row {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 8px;
  }

  .qq-card__dot {
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--qq-accent);
  }

  .qq-card__title {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    color: #121831;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .qq-card__desc {
    margin: 0;
    color: #a2abbc;
    font-size: 13px;
    line-height: 1.45;
  }

  .qq-card__button {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 8px;
    background: var(--qq-accent);
    color: #ffffff;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.35;
    padding: 6px 12px;
    text-decoration: none;
    transition:
      transform var(--transition-fast),
      filter var(--transition-fast),
      background-color var(--transition-fast);
  }

  .qq-card__button:hover,
  .qq-card__button:focus-visible {
    color: #ffffff;
    filter: brightness(0.96);
    transform: translateY(-1px);
  }

  .qq-card__button.is-copied {
    filter: brightness(1.02);
  }

  .qq-tip {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
    padding: 16px;
    border-left: 4px solid #e97f0f;
    border-radius: 8px;
