      top: 24px;
      right: 22px;
    }

    .qq-modal {
      gap: 24px;
    }

    .qq-section__grid {
      grid-template-columns: 1fr;
    }

    .qq-card {
      min-height: 140px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qq-card__button {
      transition: none;
    }

    .qq-card__button:hover,
    .qq-card__button:focus-visible {
