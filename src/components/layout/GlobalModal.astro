    color: var(--qq-accent);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.4;
    white-space: nowrap;
  }

  .qq-section__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
  }

  .qq-card {
    position: relative;
    display: flex;
