<script is:inline>
  (function () {
    var root = document.documentElement;
    var ua = navigator.userAgent || '';
    var uaData = navigator.userAgentData;
    var mobileLike = Boolean(
      (uaData && uaData.mobile) ||
      /Android|iPhone|iPod|IEMobile|Opera Mini|Mobile/i.test(ua) ||
      (/Macintosh/i.test(ua) && navigator.maxTouchPoints > 1)
    );
    var scheduled = false;
    var mobileLandscapeHeight = 0;
    var mobileLandscapeWidth = 0;

    function updateViewportMode() {
      scheduled = false;

      var width = window.innerWidth || document.documentElement.clientWidth || 1600;
      var height = window.innerHeight || document.documentElement.clientHeight || 900;
      var ratio = width / Math.max(height, 1);
      var screenOrientation = window.screen && window.screen.orientation;
      var orientationType = screenOrientation && screenOrientation.type;
      var legacyOrientation = Reflect.get(window, 'orientation');
      var mobileScreenIsPortrait =
        mobileLike &&
        (orientationType
          ? orientationType.indexOf('portrait') === 0
          : typeof legacyOrientation === 'number'
            ? Math.abs(legacyOrientation) !== 90
            : window.screen && window.screen.height >= window.screen.width);
      var wide = !mobileScreenIsPortrait && width >= 480 && ratio >= 1.25;
      var compactNav = mobileLike || width < 760;
      var scaleHeight = height;

      // Mobile browser chrome changes innerHeight while scrolling. Keep the
      // smaller landscape height so the composition does not "breathe".
      if (mobileLike && wide) {
        if (!mobileLandscapeHeight || Math.abs(width - mobileLandscapeWidth) > 80) {
          mobileLandscapeHeight = height;
          mobileLandscapeWidth = width;
        } else {
          mobileLandscapeHeight = Math.min(mobileLandscapeHeight, height);
        }
        scaleHeight = mobileLandscapeHeight;
      } else {
        mobileLandscapeHeight = 0;
        mobileLandscapeWidth = 0;
      }

      var scale = wide ? Math.min(1.6, width / 1600, scaleHeight / 900) : Math.max(0.82, Math.min(1.2, width / 390));
      var previousLayout = root.dataset.layout;
      var previousNav = root.dataset.nav;

      root.dataset.device = mobileLike ? 'mobile' : 'desktop';
      root.dataset.layout = wide ? 'wide' : 'compact';
      root.dataset.nav = compactNav ? 'compact' : 'full';
      root.dataset.orientation = width >= height ? 'landscape' : 'portrait';
      root.style.setProperty('--ui-scale', scale.toFixed(4));
      root.style.setProperty('--viewport-width', width + 'px');
      root.style.setProperty('--viewport-height', height + 'px');

      if (previousLayout && (previousLayout !== root.dataset.layout || previousNav !== root.dataset.nav)) {
        window.dispatchEvent(
          new CustomEvent('viewportmodechange', {
            detail: {
              layout: root.dataset.layout,
              nav: root.dataset.nav,
              device: root.dataset.device,
              scale: scale,
            },
          })
        );
      }
    }

    function scheduleUpdate() {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(updateViewportMode);
    }

    updateViewportMode();
    window.addEventListener('resize', scheduleUpdate, { passive: true });
    window.addEventListener('orientationchange', scheduleUpdate, { passive: true });
    window.addEventListener('pageshow', scheduleUpdate, { passive: true });
  })();
</script>
