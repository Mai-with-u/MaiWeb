---
import Dialog from './Dialog.astro';
import { links } from '../../data/links';
import { useI18n } from '../../lib/i18n';

const { t } = useI18n(Astro.url);

// 手动选源弹窗：首屏按钮已经按访客地区自动选源，这里留给想指定来源的用户，
// 从“其他部署方式”里的 Windows 一键包进入。两个入口都只走点名的那个源，不替用户换源。
---

<Dialog id="download-sources" labelledby="download-sources-title" width="36rem">
  <div class="download-sources">
    <header>
      <h2 id="download-sources-title">{t('选择下载源')}</h2>
    </header>
    <div class="source-list">
      <a class="source source-cnb" href={links.oneKeyCnbDownload} target="_blank" rel="noopener noreferrer">
        <strong>{t('CNB 国内源')}</strong>
        <span>{t('国内网络推荐，直接下载最新安装包。')}</span>
        <span class="source-action">
          {t('从 CNB 下载')} <span aria-hidden="true">↗</span>
        </span>
      </a>
      <a class="source" href={links.oneKeyGitHubDownload} target="_blank" rel="noopener noreferrer">
        <strong>{t('GitHub 源')}</strong>
        <span>{t('从 GitHub 官方仓库下载安装包。')}</span>
        <span class="source-action">
          {t('从 GitHub 下载')} <span aria-hidden="true">↗</span>
        </span>
      </a>
    </div>
  </div>
</Dialog>

<style>
  .download-sources {
    display: grid;
    gap: 1.5rem;
  }

  header {
    padding-right: 2.5rem;
  }

  h2 {
    font-size: 1.75rem;
  }

  .source-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 0.875rem;
  }

  .source {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--surface-muted);
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .source-cnb {
    border-color: rgba(var(--c-primary-rgb), 0.35);
    background: linear-gradient(135deg, rgba(var(--c-primary-rgb), 0.12), rgba(var(--c-primary-rgb), 0.03));
  }

  .source:hover,
  .source:focus-visible {
    border-color: var(--c-primary);
    transform: translateY(-2px);
  }

  .source strong {
    font-size: 1.25rem;
  }

  .source > span {
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .source .source-action {
    margin-top: auto;
    padding-top: 0.5rem;
    color: var(--c-primary);
    font-weight: 700;
  }
</style>
