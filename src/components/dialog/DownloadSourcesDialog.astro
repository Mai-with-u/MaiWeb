---
import Dialog from './Dialog.astro';
import { links } from '../../data/links';
import { useI18n } from '../../lib/i18n';

const { t } = useI18n(Astro.url);

// 手动选源弹窗：首屏按钮已经按访客地区自动选源，这里留给想指定来源的用户，
// 从“其他部署方式”里的 Windows 一键包进入。两个入口都只走点名的那个源，不替用户换源。
---

<Dialog id="download-sources" labelledby="download-sources-title" width="36rem">
  <div class="download-sources">
    <header>
      <h2 id="download-sources-title">{t('选择下载源')}</h2>
    </header>
    <div class="source-list">
      <a class="source source-cnb" href={links.oneKeyCnbDownload} target="_blank" rel="noopener noreferrer">
        <strong>{t('CNB 国内源')}</strong>
        <span>{t('国内网络推荐，直接下载最新安装包。')}</span>
        <span class="source-action">
          {t('从 CNB 下载')} <span aria-hidden="true">↗</span>
        </span>
      </a>
      <a class="source" href={links.oneKeyGitHubDownload} target="_blank" rel="noopener noreferrer">
        <strong>{t('GitHub 源')}</strong>
        <span>{t('从 GitHub 官方仓库下载安装包。')}</span>
        <span class="source-action">
          {t('从 GitHub 下载')} <span aria-hidden="true">↗</span>
        </span>
      </a>
    </div>
    <a
      class="other-methods"
      href={links.manual}
      data-dialog="versions"
      aria-haspopup="dialog"
      aria-controls="dialog-versions"
    >
      <span class="other-text">
        <strong>{t('不是 Windows？查看其他版本')}</strong>
        <span class="other-tags">
          <span>{t('Android 客户端')}</span>
          <span>uv</span>
          <span>Docker</span>
          <span>{t('Linux 服务器')}</span>
        </span>
      </span>
      <span class="other-arrow" aria-hidden="true">
        →
      </span>
    </a>
  </div>
</Dialog>

<style>
  .download-sources {
    display: grid;
    gap: 1.5rem;
  }

  header {
    padding-right: 2.5rem;
  }

  h2 {
    font-size: 1.75rem;
  }

  .source-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 0.875rem;
  }

  .source {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--surface-muted);
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .source-cnb {
    border-color: rgba(var(--c-primary-rgb), 0.35);
    background: linear-gradient(135deg, rgba(var(--c-primary-rgb), 0.12), rgba(var(--c-primary-rgb), 0.03));
  }

  .source:hover,
  .source:focus-visible {
    border-color: var(--c-primary);
    transform: translateY(-2px);
  }

  /* 其他平台入口：整行卡片，列出 Android 和高级部署方式，让非 Windows 用户一眼能找到 */
  .other-methods {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-md);
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .other-methods:hover,
  .other-methods:focus-visible {
    border-color: var(--c-primary);
    border-style: solid;
    background: rgba(var(--c-primary-rgb), 0.05);
  }

  .other-text {
    display: grid;
    flex: 1;
    gap: 0.625rem;
  }

  .other-text strong {
    font-size: 1.0625rem;
  }

  .other-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .other-tags span {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--surface-muted);
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .other-arrow {
    color: var(--c-primary);
    font-size: 1.25rem;
    font-weight: 700;
    transition: transform var(--transition-fast);
  }

  .other-methods:hover .other-arrow,
  .other-methods:focus-visible .other-arrow {
    transform: translateX(0.25rem);
  }

  .source strong {
    font-size: 1.25rem;
  }

  .source > span {
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .source .source-action {
    margin-top: auto;
    padding-top: 0.5rem;
    color: var(--c-primary);
    font-weight: 700;
  }
</style>
