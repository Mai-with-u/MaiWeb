---
import { useI18n } from '../../lib/i18n';
import Dialog from './Dialog.astro';
import { qqGroupSections, socialLinks } from '../../data/community';
const { t, locale } = useI18n(Astro.url);

// QQ 群弹窗：首屏“QQ群”按钮带 data-dialog="qq"，点击后打开。
// 群列表在构建时从数据层渲染成静态 HTML，样式可以正常走组件作用域，不再用 innerHTML 拼字符串。
---

<Dialog id="qq" labelledby="qq-dialog-title">
  <div class="qq">
    <header class="qq-header">
      <h2 id="qq-dialog-title" class="qq-title">
        {t('QQ 交流群')}
      </h2>
      <span class="qq-accent" aria-hidden="true"></span>
      <p class="qq-subtitle">{t('按用途分了好几个群，挑一个进来吧')}</p>
    </header>

    {qqGroupSections.map((section) => (
      <section class={`qq-section tone-${section.tone}`} aria-label={t(section.title)}>
        <h3 class="qq-section-label">{t(section.title)}</h3>
        <div class="qq-grid">
          {section.groups.map((group) => (
            <article class="qq-card">
              <div class="qq-card-body">
                <h4 class="qq-card-title">
                  <span class="qq-dot" aria-hidden="true" />
                  {t(group.name)}
                </h4>
                <p class="qq-card-desc">{t(group.description)}</p>
              </div>
              <a
                class="qq-join"
                href={group.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={locale === 'en' ? `Join ${t(group.name)} on QQ` : `加入 ${group.name} QQ 群`}
              >
                {t('加入群聊 →')}
              </a>
            </article>
          ))}
        </div>
      </section>
    ))}

    <section class="qq-section" aria-label={t('不用 QQ 的话')}>
      <h3 class="qq-section-label tone-muted">{t('不用 QQ 的话')}</h3>
      <div class="qq-social">
        {socialLinks.map((item) => (
          <a
            class="qq-social-link"
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            title={t(item.description)}
          >
            {item.name}
          </a>
        ))}
      </div>
    </section>

    <aside class="qq-tip">
      <strong>{t('先看一眼再进群')}</strong>
      <p>{t('技术问题去技术交流群问，闲聊群只唠嗑、不答疑。在写插件的话，来插件开发群一起折腾。')}</p>
    </aside>
  </div>
</Dialog>

<style>
  .qq {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .qq-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding-right: 3.5rem;
  }

  .qq-title {
    font-size: clamp(1.5rem, 1.3rem + 1vw, 1.75rem);
    line-height: 1.1;
  }

  .qq-accent {
    width: 3.75rem;
    height: 0.25rem;
    border-radius: 2px;
    background: var(--c-primary);
  }

  .qq-subtitle {
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  /* 每个分组用一种强调色，卡片底色、描边、按钮都由 --tone 派生 */
  .qq-section {
    --tone: var(--c-primary-rgb);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .tone-green {
    --tone: var(--c-green-rgb);
  }

  .tone-blue {
    --tone: var(--c-blue-rgb);
  }

  .tone-purple {
    --tone: var(--c-purple-rgb);
  }

  .qq-section-label {
    padding: 0.25rem 1rem 0.25rem 0.75rem;
    border-left: 0.25rem solid rgb(var(--tone));
    border-radius: 0.25rem;
    background: rgba(var(--tone), 0.1);
    color: rgb(var(--tone));
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  .qq-section-label.tone-muted {
    border-color: var(--text-subtle);
    background: var(--surface-muted);
    color: var(--text-muted);
  }

  .qq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12.5rem), 1fr));
    gap: 0.75rem;
    width: 100%;
  }

  .qq-card {
    display: flex;
    min-width: 0;
    min-height: 8.75rem;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem 1.25rem 1.25rem;
    border: 1px solid rgba(var(--tone), 0.2);
    border-radius: var(--radius-sm);
    background: rgba(var(--tone), 0.08);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 1.125rem), calc(100% - 1.125rem) 100%, 0 100%);
  }

  .qq-card-body {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.375rem;
  }

  .qq-card-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    font-size: 1rem;
    line-height: 1.35;
  }

  .qq-dot {
    width: 0.5rem;
    height: 0.5rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: rgb(var(--tone));
  }

  .qq-card-desc {
    color: var(--text-muted);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .qq-join {
    align-self: flex-start;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-sm);
    background: rgb(var(--tone));
    color: #fff;
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 700;
    line-height: 1.35;
    transition:
      transform var(--transition-fast),
      filter var(--transition-fast);
  }

  .qq-join:hover,
  .qq-join:focus-visible {
    filter: brightness(0.95);
    transform: translateY(-1px);
  }

  /* 不用 QQ 的入口：一排和“加入群聊”同款的小药丸，只是换成中性灰，避免抢过群聊按钮 */
  .qq-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .qq-social-link {
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-sm);
    background: var(--surface-muted);
    color: var(--text-body);
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 700;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .qq-social-link:hover,
  .qq-social-link:focus-visible {
    background: rgba(var(--c-primary-rgb), 0.12);
    color: var(--c-primary);
    transform: translateY(-1px);
  }

  .qq-tip {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    border-left: 0.25rem solid var(--c-primary);
    border-radius: var(--radius-sm);
    background: rgba(var(--c-primary-rgb), 0.1);
  }

  .qq-tip strong {
    color: var(--c-primary);
    font-family: var(--font-display);
    font-size: var(--fs-small);
  }

  .qq-tip p {
    color: var(--text-body);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
</style>
