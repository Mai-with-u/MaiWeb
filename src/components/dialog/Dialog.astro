---
import { useI18n } from '../../lib/i18n';
const { t } = useI18n(Astro.url);
// 通用弹窗外壳，基于原生 <dialog>：
// 页面上任意带 data-dialog="xxx" 的元素被点击 -> 打开 id 为 dialog-xxx 的弹窗；
// 焦点圈定、Esc 关闭、关闭后焦点回到触发按钮都由浏览器原生处理，不再手写焦点陷阱。
interface Props {
  id: string;
  labelledby: string;
  width?: string;
}

const { id, labelledby, width = '47.5rem' } = Astro.props;
---

<dialog id={`dialog-${id}`} class="dialog" aria-labelledby={labelledby} style={`--dialog-width: ${width}`}>
  <div class="dialog-card">
    <button type="button" class="dialog-close" data-dialog-close aria-label={t('关闭')}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
    <slot />
  </div>
</dialog>

<script>
  // 同一页面引用多个弹窗时 Astro 只打包一份脚本，事件委托到 document 上统一处理
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    // 1. 点击触发器：找到对应弹窗并以模态方式打开
    const trigger = target.closest<HTMLElement>('[data-dialog]');
    if (trigger) {
      const dialog = document.getElementById(`dialog-${trigger.dataset.dialog}`);
      if (dialog instanceof HTMLDialogElement) {
        event.preventDefault();
        dialog.showModal();
      }
      return;
    }

    // 2. 点击关闭按钮：关闭所在弹窗
    if (target.closest('[data-dialog-close]')) {
      target.closest('dialog')?.close();
      return;
    }

    // 3. 点击卡片外的遮罩：事件目标是 dialog 元素本身（卡片内容都包在 .dialog-card 里）
    if (target instanceof HTMLDialogElement && target.open) target.close();
  });
</script>

<style>
  /* 弹窗沿用导航栏的造型：右下角切角 + 左侧橙色竖条。
     dialog 本身透明，只负责滚动和投影（drop-shadow 跟着切角的形状走）；
     卡片 .dialog-card 负责底色和切角，切角用 clip-path，所以投影不能放在卡片上，否则会被一起切掉 */
  .dialog {
    width: min(var(--dialog-width), calc(100vw - 2rem));
    max-width: none;
    max-height: min(88dvh, calc(100dvh - 2rem - var(--safe-top) - var(--safe-bottom)));
    margin: auto;
    padding: 0;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: none;
    background: transparent;
    color: var(--text-strong);
    filter: drop-shadow(0 1.25rem 2.5rem rgba(18, 24, 49, 0.25));
    scrollbar-width: thin;
  }

  .dialog::backdrop {
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(0.25rem);
  }

  .dialog[open] {
    animation: dialog-in 0.24s cubic-bezier(0.2, 0.9, 0.3, 1.15);
  }

  .dialog[open]::backdrop {
    animation: backdrop-in 0.22s ease-out;
  }

  @keyframes dialog-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.97);
    }
  }

  @keyframes backdrop-in {
    from {
      opacity: 0;
    }
  }

  .dialog-card {
    position: relative;
    padding: clamp(1.5rem, 5vw, 2.5rem) clamp(1.5rem, 5vw, 2.5rem) clamp(1.5rem, 5vw, 2.5rem)
      clamp(1.75rem, 5vw, 2.75rem);
    background: var(--surface);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 1.5rem), calc(100% - 1.5rem) 100%, 0 100%);
  }

  /* 左侧橙色竖条，与导航栏、首屏按钮一致 */
  .dialog-card::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0.25rem;
    content: '';
    background: rgba(var(--c-primary-rgb), 0.85);
  }

  /* 关闭按钮和导航栏的图标按钮一样：平时透明，悬停时浅橙底、橙色图标 */
  .dialog-close {
    position: absolute;
    top: clamp(0.75rem, 3vw, 1.25rem);
    right: clamp(0.75rem, 3vw, 1.25rem);
    z-index: 2;
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-subtle);
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .dialog-close:hover,
  .dialog-close:focus-visible {
    background: rgba(var(--c-primary-rgb), 0.1);
    color: var(--c-primary);
    transform: rotate(90deg);
  }
</style>
