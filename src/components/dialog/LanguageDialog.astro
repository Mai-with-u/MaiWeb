---
import Dialog from './Dialog.astro';
import { useI18n, localePath } from '../../lib/i18n';
const { locale, t } = useI18n(Astro.url);

// 语言切换弹窗：导航栏的“文A”按钮带 data-dialog="lang"，点击后打开。
// 切换时保留对应页面，页面路径是语言的唯一来源，直接访问和刷新都有效。
const languages = [
  { code: 'zh-CN', name: '简体中文', href: localePath(Astro.url.pathname, 'zh-CN'), current: locale === 'zh-CN' },
  { code: 'en', name: 'English', href: localePath(Astro.url.pathname, 'en'), current: locale === 'en' },
];
---

<Dialog id="lang" labelledby="lang-dialog-title" width="22.5rem">
  <div class="lang">
    <h2 id="lang-dialog-title" class="lang-title">
      {t('切换语言')}
    </h2>
    <p class="lang-subtitle">{locale === 'en' ? 'Choose your language' : 'Language'}</p>
    <ul class="lang-list">
      {languages.map((language) => (
        <li>
          {!language.current ? (
            <a
              class="lang-option"
              href={language.href}
              lang={language.code}
              hreflang={language.code}
              data-language-link
            >
              <span class="lang-name">{language.name}</span>
              <span class="lang-note" aria-hidden="true">
                →
              </span>
            </a>
          ) : (
            <span
              class="lang-option is-current"
              lang={language.code}
              aria-current={language.current ? 'true' : undefined}
            >
              <span class="lang-name">{language.name}</span>
              <span class="lang-note">{locale === 'en' ? 'Current' : '正在用'}</span>
            </span>
          )}
        </li>
      ))}
    </ul>
  </div>
</Dialog>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-language-link]').forEach((link) => {
    const target = new URL(link.href);
    target.search = window.location.search;
    target.hash = window.location.hash;
    link.href = target.toString();
  });
</script>

<style>
  .lang {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .lang-title {
    padding-right: 3.5rem;
    font-size: 1.375rem;
  }

  .lang-subtitle {
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .lang-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1rem;
    list-style: none;
  }

  /* 选项沿用首屏小按钮的造型；当前语言以文字标明。 */
  .lang-option {
    --tone: var(--c-primary-rgb);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.875rem 1rem 0.875rem 1.25rem;
    background: linear-gradient(135deg, rgba(var(--tone), 0.1) 0%, rgba(var(--tone), 0.03) 100%);
    box-shadow: inset 0 0 0 2px rgba(var(--tone), 0.18);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 0.625rem), calc(100% - 0.625rem) 100%, 0 100%);
  }

  .lang-option::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0.25rem;
    content: '';
    background: rgb(var(--tone));
  }

  .lang-name {
    font-family: var(--font-display);
    font-weight: 700;
  }

  .lang-note {
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }

  .is-current .lang-note {
    color: var(--c-primary);
    font-weight: 700;
  }
</style>
