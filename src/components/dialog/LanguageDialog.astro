---
import Dialog from './Dialog.astro';

// 语言切换弹窗：导航栏的“文A”按钮带 data-dialog="lang"，点击后打开。
// 目前站点只有简体中文，English 标为筹备中；接入多语言后在 languages 里补上对应路径即可。
const languages = [
  { code: 'zh-CN', name: '简体中文', note: '当前语言', href: '/', current: true },
  { code: 'en', name: 'English', note: '筹备中 · Coming soon', href: undefined, current: false },
];
---

<Dialog id="lang" labelledby="lang-dialog-title" width="22.5rem">
  <div class="lang">
    <h2 id="lang-dialog-title" class="lang-title">
      切换语言
    </h2>
    <p class="lang-subtitle">Language</p>
    <ul class="lang-list">
      {languages.map((language) => (
        <li>
          {language.href && !language.current ? (
            <a class="lang-option" href={language.href} lang={language.code}>
              <span class="lang-name">{language.name}</span>
              <span class="lang-note">{language.note}</span>
            </a>
          ) : (
            <span
              class:list={['lang-option', { 'is-current': language.current, 'is-disabled': !language.current }]}
              lang={language.code}
              aria-current={language.current ? 'true' : undefined}
              aria-disabled={language.current ? undefined : 'true'}
            >
              <span class="lang-name">{language.name}</span>
              <span class="lang-note">{language.note}</span>
            </span>
          )}
        </li>
      ))}
    </ul>
  </div>
</Dialog>

<style>
  .lang {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .lang-title {
    padding-right: 3.5rem;
    font-size: 1.375rem;
  }

  .lang-subtitle {
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .lang-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1rem;
    list-style: none;
  }

  .lang-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-muted);
  }

  /* 当前语言用品牌色描边标出 */
  .lang-option.is-current {
    border-color: rgba(var(--c-primary-rgb), 0.45);
    background: rgba(var(--c-primary-rgb), 0.08);
  }

  .lang-option.is-disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .lang-name {
    font-family: var(--font-display);
    font-weight: 700;
  }

  .lang-note {
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }

  .is-current .lang-note {
    color: var(--c-primary);
    font-weight: 700;
  }
</style>
