---
import Dialog from './Dialog.astro';

// 语言切换弹窗：导航栏的“文A”按钮带 data-dialog="lang"，点击后打开。
// 目前站点只有简体中文，English 标为筹备中；接入多语言后在 languages 里补上对应路径即可。
const languages = [
  { code: 'zh-CN', name: '简体中文', note: '正在用', href: '/', current: true },
  { code: 'en', name: 'English', note: '麦麦还在学 · Coming soon', href: undefined, current: false },
];
---

<Dialog id="lang" labelledby="lang-dialog-title" width="22.5rem">
  <div class="lang">
    <h2 id="lang-dialog-title" class="lang-title">
      切换语言
    </h2>
    <p class="lang-subtitle">Language</p>
    <ul class="lang-list">
      {languages.map((language) => (
        <li>
          {language.href && !language.current ? (
            <a class="lang-option" href={language.href} lang={language.code}>
              <span class="lang-name">{language.name}</span>
              <span class="lang-note">{language.note}</span>
            </a>
          ) : (
            <span
              class:list={['lang-option', { 'is-current': language.current, 'is-disabled': !language.current }]}
              lang={language.code}
              aria-current={language.current ? 'true' : undefined}
              aria-disabled={language.current ? undefined : 'true'}
            >
              <span class="lang-name">{language.name}</span>
              <span class="lang-note">{language.note}</span>
            </span>
          )}
        </li>
      ))}
    </ul>
  </div>
</Dialog>

<style>
  .lang {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .lang-title {
    padding-right: 3.5rem;
    font-size: 1.375rem;
  }

  .lang-subtitle {
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .lang-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1rem;
    list-style: none;
  }

  /* 选项沿用首屏小按钮的造型：左侧竖条 + 半透明底 + 内描边 + 右下切角；
     当前语言用橙色，还没上线的语言用灰色并禁用 */
  .lang-option {
    --tone: var(--c-primary-rgb);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.875rem 1rem 0.875rem 1.25rem;
    background: linear-gradient(135deg, rgba(var(--tone), 0.1) 0%, rgba(var(--tone), 0.03) 100%);
    box-shadow: inset 0 0 0 2px rgba(var(--tone), 0.18);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 0.625rem), calc(100% - 0.625rem) 100%, 0 100%);
  }

  .lang-option::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0.25rem;
    content: '';
    background: rgb(var(--tone));
  }

  .lang-option.is-disabled {
    --tone: 162, 171, 188;
    cursor: not-allowed;
  }

  .lang-option.is-disabled .lang-name {
    color: var(--text-muted);
  }

  .lang-name {
    font-family: var(--font-display);
    font-weight: 700;
  }

  .lang-note {
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }

  .is-current .lang-note {
    color: var(--c-primary);
    font-weight: 700;
  }
</style>
